// The raiders of a Convoy Duty (spec 36). C# reads this file (Missions/EscortObjective.cs) when the freighter has covered
// MissionTunables.EscortAmbushAt of its route. The root location is EscortAmbushLead ahead of the freighter, on its route.
// It is not part of the game rules tree, so "&/" references do not work here. Use "&<./Data/...>" paths.
// A rules change here needs a game restart.
Ambush
{
	Spawners
	[
		{
			Type = Ships
			Tags = [hc_escort_raider]
			Count = [2, 3]
			Distance = [0, 500]
			// Unique allegiance, so they are hostile to everyone, the freighter included.
			Allegiance = Unique
			SynchronizeAllegiance = true
			SuppressLocationAssertions = true
			FamePerTier = &<./Data/modes/career/tier_tables.rules>/StandardFamePerTier
			MaxFamePerTier = &<./Data/modes/career/tier_tables.rules>/StandardMaxFamePerTier
			// Sector tier - 1.
			ShipCriteria
			{
				UseLocalFactionWeights = true
				UseTierField = true
				Tier = -1
				AllowTierRangeExpansion = true
				Tags = [combat]
			}
			// No range from the origin, so they chase the convoy as long as they see it. Missions/ConvoyTargetPatch.cs makes them want the freighter.
			AI
			{
				Type = Normal
				ChanceToConsiderSurrenderingToPlayer = 0
				PatrolRadius = 500
			}
		}
	]
}
