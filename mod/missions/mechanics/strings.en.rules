HotCargoMechanics
{
	DroneSiege = "Drone Siege"
	DroneSiegeDesc = "Hold the listening post <b>{target_ship}</b> against drones for {hold_minutes} min.\nThe clock stops when no ship is near. Leave early to keep partial pay."
	Prototype = "Prototype Retrieval"
	PrototypeDesc = "Disable <b>{target_ship}</b> or make it surrender, then lift the core into your hold.\nHand it to the broker. If it breaks, no pay."
	SunMining = "Sunside Ore"
	SunMiningDesc = "Mine {target_count} {resource_icon} {resource_type_plural} near the sun for {to_ship} within {time_limit_minutes} min.\nThe heat damages parts: keep moving."
	Tow = "Salvage Rights"
	TowDesc = "Bring the derelict <b>{target_ship}</b> to {station} within {time_limit_minutes} min.\nTow it or crew it. Do not destroy it."
	Capture = "Repossession"
	CaptureDesc = "Capture the freighter <b>{target_ship}</b>: force a surrender or board it.\nThen bring it to the bank at the station. If it is destroyed, no pay."
	Survey = "Storm Survey"
	SurveyDesc = "Hold a ship with a sensor array at each of {marker_count} storm markers for {scan_seconds} s.\nStorms hit hard: send a scout or bring shields."
	ClaimJumpers = "Claim Jumpers"
	ClaimJumpersDesc = "Guard the mining barge <b>{target_ship}</b> from raiders for {hold_minutes} min.\nThe clock stops when no ship is near. Leave early to keep partial pay."
	ListeningPost = "Listening Post"
	ListeningPostDesc = "Take the scout <b>{target_ship}</b> within {scan_km} km of the hostile base, then start the scan.\nThe base sends {wave_count} waves. Each wave pays its share; leave early to keep it."

