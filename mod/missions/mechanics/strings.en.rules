HotCargoMechanics
{
	DroneSiege = "Drone Siege"
	DroneSiegeDesc = "Someone parked a drone carrier near the {faction_name} listening post <b>{target_ship}</b> in the {mission_location} system, and the drones keep coming. "\
	                 "Hold the post for {hold_minutes} minutes and the {faction_name} pays {money}. "\
	                 "The clock only runs while one of your ships is near the post. Any crewed ship counts: "\
	                 "use <b>Build New Ship</b> next to the post, give it a reactor, a few guns and a crew of its own, and let it stand watch while you get on with your day."
	Prototype = "Prototype Retrieval"
	PrototypeDesc = "Pirates aboard the <b>{target_ship}</b> in the {mission_location} system lifted a prototype core from a corporate yard and bolted it to their hull. "\
	                "A broker wants it back in one piece and pays {money}. Pick your targets: cripple their reactors, bridge or crew until the ship is a dead hulk, "\
	                "or beat them until they hail you to surrender, and accept. Then bring a ship alongside the core and your crew lift it out. "\
	                "If the core breaks, there is no deal."
	SunMining = "Sunside Ore"
	SunMiningDesc = "Helion ore only forms on rocks that bake in a sun's glare, and there is a seam of it in the {mission_location} system. "\
	                "{to_ship} wants {target_count} {resource_icon} {resource_type_plural} within {time_limit_minutes} minutes and pays {money}, on top of the ore price. "\
	                "Mining lasers break the deposits; your crew collect the pieces. The heat out there cooks parts: keep moving, bring storage room, and do not drift toward the sun."
	Tow = "Salvage Rights"
	TowDesc = "The freighter <b>{target_ship}</b> lost its crew and drifts dead near {station} in the {mission_location} system. "\
	          "The {faction_name} holds the salvage rights and pays {money} to have the hulk brought in close to the station within {time_limit_minutes} minutes. "\
	          "Tractor beams do the job best. A crew of your own can also claim the wreck and fly it in, if anything aboard still works. Do not shoot it to pieces."
	Capture = "Repossession"
	CaptureDesc = "The freighter <b>{target_ship}</b> in the {mission_location} system missed its payments, and its crew ran off with it, escorts and all. "\
	              "The bank pays {money} for the ship, not for scrap. Beat the crew until they hail you to surrender and accept, "\
	              "or knock out the crew and send your own people aboard to claim the hull. If the freighter is destroyed, the deal is off."
	Survey = "Storm Survey"
	SurveyDesc = "The {faction_name} wants fresh readings from inside the ion storms of the {mission_location} system. "\
	             "Hold a ship with a working sensor array at each of the {marker_count} markers for {scan_seconds} seconds. "\
	             "Lightning hits hard in there: send a cheap scout or bring shields, and do not linger. Pays {money}."
	ClaimJumpers = "Claim Jumpers"
	ClaimJumpersDesc = "The mining barge <b>{target_ship}</b> works a rich claim in the {mission_location} system, and raiders want it. "\
	                   "Keep the barge alive for {hold_minutes} minutes and the {faction_name} pays {money}. "\
	                   "The clock only runs while one of your ships is near the barge, so a gun platform of your own can stand watch in your place."

	HoldFmt = "Defend {0}: {1}:{2} left"
	HoldPaused = "No ship on station: the clock is stopped"
	CoreFmt = "Recover the prototype core from {0} intact"
	CoreLost = "The prototype core was destroyed"
	TowFmt = "Bring {0} in to {1}"
	CaptureFmt = "Capture {0} intact"
	SurveyLine = "Scan storm markers"
	ScanFmt = "Scanning: {0}%"

	PrototypeCore = "Prototype Core"
	PrototypeCoreIcon = "Prototype Core"
	PrototypeCoreDesc = "A sealed corporate prototype. It does nothing for you, but someone pays well to get it back intact."
	HelionOre = "Helion Ore"
	HelionOrePlural = "Helion Ore"
	HelionOreDesc = "A heavy mineral that only forms on asteroids close to a sun. Stations buy it; Sunside Ore contracts ask for it."
	HelionDeposit = "Helion Ore Deposit"
	HelionDepositIcon = "Helion Ore"
	HelionAsteroid = "Helion Ore Asteroid"
}
