// Prototype Core (spec 133). The special part that a Prototype Retrieval carrier holds. C# (Missions/Mechanics/PrototypeObjective.cs)
// puts it on the carrier's hull. It has no function: it only needs to survive the fight.
// Vanilla storage bay sprites with a tint. It stays buildable, because a part that is not buildable cannot go on a blueprint.
Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "HotCargoMechanics/PrototypeCore"
	IconNameKey = "HotCargoMechanics/PrototypeCoreIcon"
	DescriptionKey = "HotCargoMechanics/PrototypeCoreDesc"
	ID = yarden_zamir.prototype_core
	EditorGroup = "Storage"
	SelectionTypeID = "yarden_zamir.prototype_core"
	Resources
	[
		[steel, 40]
		[processor, 1]
	]
	Size = [2, 2]
	IsRotateable = false
	// About two vanilla storage bays: a few careless hits break it, a stray volley does not.
	MaxHealth = 8000
	TypeCategories = []
	ReceivableBuffs : ^/0/ReceivableBuffs []
	IgnoreRotationForMirroredSelection = true
	TINT = [255, 120, 255]
	EditorIcon
	{
		Texture
		{
			File = "./Data/ships/terran/storage_2x2/icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
		VertexColor = &~/Part/TINT
	}
	Components : ^/0/Components
	{
		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/storage_2x2/floor.png"
						Size = [2, 2]
						VertexColor = &~/Part/TINT
					}
					{
						File = "./Data/ships/terran/storage_2x2/floor_33.png"
						Size = [2, 2]
						VertexColor = &~/Part/TINT
					}
					{
						File = "./Data/ships/terran/storage_2x2/floor_66.png"
						Size = [2, 2]
						VertexColor = &~/Part/TINT
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/storage_2x2/walls.png"
						Size = [2, 2]
						VertexColor = &~/Part/TINT
					}
					{
						File = "./Data/ships/terran/storage_2x2/walls_33.png"
