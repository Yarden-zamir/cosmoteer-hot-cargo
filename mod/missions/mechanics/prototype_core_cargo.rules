// Prototype Core as cargo: Prototype Retrieval's item once the crew lift the part off the carrier (spec 1100, 1108). Normal storage
// holds it, one to a storage slot. Stations do not trade it.
// Sprites are the vanilla processor sprites with a tint.
ID = yarden_zamir.prototype_core_cargo
NameKey = "HotCargoMechanics/PrototypeCore"
PluralNameKey = "HotCargoMechanics/PrototypeCorePlural"
DescriptionKey = "HotCargoMechanics/PrototypeCoreDesc"
// Never traded; 1, not 0, because some vanilla code divides by it.
BuyPrice = 1
MaxPerNugget = 1
MaxStackSize = 1
// Shares the processor key, so storage parts get no extra supply job.
FlexGridPriorityKey = "flex_grid_processor"
FlexGridDefaultPriority = 1
// A hit on its storage destroys the core half of the time; otherwise it drifts loose and the crew can pick it up.
DropRates
{
	StorageDestroyed = 50%
	StorageSalvaged = 100%
	CrewKilled = 100%
}
Rarity = Unique

TINT = [150, 180, 255]

Icon
{
	Texture
	{
		File = "./Data/resources/processor/icon.png"
		MipLevels = max
	}
	Size = [64, 64]
	VertexColor = &~/TINT
}

Overlay
{
	Texture
	{
		File = "./Data/resources/processor/overlay.png"
		SampleMode = Linear
		MipLevels = max
	}
	Size = [1, 1]
	VertexColor = &~/TINT
}

NuggetSprite
{
	File = "./Data/resources/processor/processor.png"
	NormalsFile = "./Data/resources/processor/processor_normals.png"
	Size = [1, 1]
	Offset = [.25+6/64, 0]
	UVRotation = 1
	VertexColor = &~/TINT
}

StackSprites
[
	{
		File = "./Data/resources/processor/processor_stack_1.png"
		Size = [1, 1]
		VertexColor = &~/TINT
	}
]

StackReceiveMediaEffects = &/COMMON_EFFECTS/ProcessorDeliver
StackPickupMediaEffects = &/COMMON_EFFECTS/ProcessorPickup
NuggetPickupMediaEffects = &/COMMON_EFFECTS/NuggetPickup
