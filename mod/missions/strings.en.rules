HotCargoMissions
{
	Escort = "Convoy Duty"
	EscortDesc = "The freighter {escort_ship} must reach a jump point in the {mission_location} system, and word is that raiders know the route. "\
	             "The convoy master needs an escort and does not ask about cargo. Keep the freighter in one piece, and the {faction_name} pays {money} when it reaches the jump point. "\
	             "A registered convoy also hides your own trail from corporate scanners for a while. The freighter waits for its escort, so stay close."
	EscortCoverFmt = "Heat {0} (convoy cover)"
	EscortCoverTip = "Flying in a registered convoy hides your trail. Heat changes when you collect the reward."
	FleetAssault = "Joint Strike"
	FleetAssaultDesc = "The {faction_name} navy has found a raider stronghold in the {mission_location} system and has sent a strike group to take it apart. "\
	                   "The navy wants another gun on the line and has better things to do than check your cargo. Meet the strike group near the stronghold and destroy it together. "\
	                   "The navy pays {money} when the station is gone."
	ShadyBounty = "Discreet Bounty"
	ShadyBountyDesc = "A client who does not give a name wants the <b>{target_ship}</b> class vessel in the {mission_location} system gone. "\
	                  "No faction seal, no paperwork, no questions. The client pays {money}, well above the going rate, and says that you will want to come alone."
}

HotCargoObjectives
{
	EscortFmt = "Escort {0} to the jump point"
	SurviveAmbush = "Survive the ambush"
	TrapSprung = "It was a setup. Corporate hunters drop out of the dark!"
}
