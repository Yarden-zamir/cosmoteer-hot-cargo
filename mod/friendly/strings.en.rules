// Friendly encounters (spec 1360 and later). {0} = a ship.
HotCargoFriendly
{
	JoinedFmt = "{0} joins your fleet."
	JoinGone = "The ship is gone before it can join you."
	FollowerGone = "The ship is gone before it can follow you."
	LeavesFmt = "{0} spins up its drive and leaves the system."
	// Riddle ship (spec 1366). {0} = heat before, {1} = heat after.
	// Debtor (spec 1367, 1368). {1} = minutes, {2} = credits.
	DebtorFollowsFmt = "You own the debt of {0} now. It follows you and fights for you for {1} minutes, then pays you {2} credits."
	DebtorPaysFmt = "{0} pays you back {1} credits and leaves. \"We're square.\""
	DebtorDiedFmt = "{0} is destroyed. Its debt of {1} credits dies with it."
	DebtorBehind = "Your debtor cannot jump with you. It stays behind and pays when its time is up."
	LabelDebtorFmt = "DEBTOR OWES {0}  {1}"
	// Pay it forward (spec 1369 to 1371). {0} = ships.
	WayfarersArriveFmt = "{0} Wayfarer ships drop out of FTL beside you. \"Hold on, we've got you!\""
	WayfarersWords = "The Wayfarers hail you: \"No charge. Pay it forward to the next one in need.\""
	WayfarersRepair = "The Wayfarers patch their hulls."
	WayfarersLeave = "The Wayfarers spin up their drives and leave."
	LabelWayfarer = "WAYFARER"
	HeatHalvedFmt = "Their contacts lose your trail. Heat {0} -> {1}."
	// Apprentice (spec 1362, 1363). {1} = fights it saw, {2} = fights it wants to see.
	ApprenticeFollowsFmt = "{0} follows you for {1} minutes to learn. It wants to see {2} fights."
	ApprenticeJoinsFmt = "{0} saw {1} fights with you. \"We fly with you now.\" It joins your fleet."
	ApprenticeLeavesFmt = "{0} saw {1} of {2} fights. \"Thanks for the lesson.\" It leaves."
	ApprenticeRanFmt = "{0} took too much damage. \"That was enough of a lesson.\" It leaves."
	ApprenticeBehind = "Your apprentice cannot jump with you. It stays behind."
	LabelApprenticeFmt = "APPRENTICE {0}/{1} FIGHTS"
}
