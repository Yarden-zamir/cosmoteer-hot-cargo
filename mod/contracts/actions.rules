	// Spec 105: smaller star systems and fewer missions per system, for shorter in-system travel and a faster run.
	// Distances, gaps and counts follow contracts/system_scale.rules (the rules for each kind of value are there).
	// These change the shared sector rules, so they apply to every map size while the mod is on.
	// The trade stations move in with the gates, so the gates stay outside the station ring.
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_trade_stations.rules>/SubSpawners/0"
		Overrides
		{
			Distance = &<contracts/system_scale.rules>/TradeStationDistance
			MinDistanceFromTags = [[sun, "max((&<contracts/system_scale.rules>/Scale) * 7500, (&<contracts/system_scale.rules>/SunClearance))"]]
		}
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_trade_stations.rules>/SubSpawners/1"
		Overrides
		{
			Count = [2, 3] // was [2, 4] stations outside the starting system: fewer missions, not the area
			Distance = &<contracts/system_scale.rules>/TradeStationDistance
			MinDistanceFromTags = [[sun, "max((&<contracts/system_scale.rules>/Scale) * 7500, (&<contracts/system_scale.rules>/SunClearance))"]]
		}
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_military_stations.rules>/BaseMilitaryStation"
		// The Joint Strike stronghold (missions/sysgen_hotcargo.rules) and the Deep Space lair (worlds/sysgen_worlds.rules) inherit this spawner.
		Overrides
		{
			Distance = [0, "(&<contracts/system_scale.rules>/Scale) * 20000"]
			MinDistanceFromTags
			[
				[sun, "max((&<contracts/system_scale.rules>/Scale) * 7500, (&<contracts/system_scale.rules>/SunClearance))"]
				[station, "(&<contracts/system_scale.rules>/Scale) * 6000"]
				[ftl_gate, "(&<contracts/system_scale.rules>/Scale) * 3000"]
			]
		}
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_bounties.rules>"
		Overrides
		{
			Count = [2, 4] // was 99 (as many as fit): fewer missions, not the area
			Distance = [0, "(&<contracts/system_scale.rules>/Scale) * 19000"]
			MinDistanceFromTags
			[
				[sun, "max((&<contracts/system_scale.rules>/Scale) * 6000, (&<contracts/system_scale.rules>/SunClearance))"]
				[station, "(&<contracts/system_scale.rules>/Scale) * 4000"]
				[bounty, "(&<contracts/system_scale.rules>/Scale) * 6000"]
			]
		}
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sector_basic/sector_basic.rules>/Sector/ResourceDeliveryMissions"
		Overrides { SimultaneousMissionsPerStation = 1 } // was 2
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_ftl_gates.rules>"
		Overrides { Distance = &<contracts/system_scale.rules>/GateDistance }
	}
	// Pirates.
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_wanderers.rules>/SubSpawners/0"
		Overrides
		{
			Count = ["max(1, round(14 * (&<contracts/system_scale.rules>/Area), 0))", "max(1, round(16 * (&<contracts/system_scale.rules>/Area), 0))"]
			Distance = [0, "(&<contracts/system_scale.rules>/Scale) * 18000"]
			MinDistanceFromTags
			[
				[sun, "max((&<contracts/system_scale.rules>/Scale) * 6000, (&<contracts/system_scale.rules>/SunClearance))"]
				[station, "(&<contracts/system_scale.rules>/Scale) * 2000"]
				[pirate, "(&<contracts/system_scale.rules>/Scale) * 4500"]
			]
		}
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_wanderers.rules>/SubSpawners/0/AI"
		Overrides { PatrolRadius = "(&<contracts/system_scale.rules>/Scale) * 7500" }
	}
	// Faction wanderers. Their patrol radius is their spawn distance (vanilla rules), so it follows.
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_wanderers.rules>/SubSpawners/1"
		Overrides
		{
			Count = ["max(1, round(14 * (&<contracts/system_scale.rules>/Area), 0))", "max(1, round(16 * (&<contracts/system_scale.rules>/Area), 0))"]
			Distance = [0, "(&<contracts/system_scale.rules>/Scale) * 18000"]
			MinDistanceFromTags = [[sun, "max((&<contracts/system_scale.rules>/Scale) * 6000, (&<contracts/system_scale.rules>/SunClearance))"], [station, 500]]
		}
	}
	// One belt.
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_asteroids.rules>/SubSpawners/0"
		Overrides { Distance = ["(&<contracts/system_scale.rules>/Scale) * 11000", "(&<contracts/system_scale.rules>/Scale) * 15000"] }
	}
	// Several belts (supernova systems).
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_asteroids.rules>/SubSpawners/1"
		Overrides
		{
			Distance = ["(&<contracts/system_scale.rules>/Scale) * 5000", "(&<contracts/system_scale.rules>/Scale) * 20000"]
			MinDistanceFromSiblingOrbits = "(&<contracts/system_scale.rules>/Scale) * 2000"
		}
	}
	// Belt rocks: a belt orbit is Scale times as long, and the band keeps its width, so the count drops by Scale.
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_asteroids.rules>/AsteroidBelt/SubSpawners/0"
		Overrides { Count = ["round(750 * (&<contracts/system_scale.rules>/Scale), 0)", "round(900 * (&<contracts/system_scale.rules>/Scale), 0)"] }
	}
	// Asteroid fields.
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_asteroids.rules>/SubSpawners/2"
		Overrides
		{
			Count = ["max(1, round(4 * (&<contracts/system_scale.rules>/Area), 0))", "max(1, round(6 * (&<contracts/system_scale.rules>/Area), 0))"]
			Distance = [0, "(&<contracts/system_scale.rules>/Scale) * 15000"]
			MinDistanceFromTags
			[
				[sun, "max((&<contracts/system_scale.rules>/Scale) * 6000, (&<contracts/system_scale.rules>/SunClearance))"]
				[station, "(&<contracts/system_scale.rules>/Scale) * 3000"]
				[asteroid_field, 600]
			]
		}
	}
	// Loose asteroids. They keep the vanilla sun gap (3850, just past the heat).
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_asteroids.rules>/SubSpawners/3"
		Overrides
		{
			Count = ["round(125 * (&<contracts/system_scale.rules>/Area), 0)", "round(150 * (&<contracts/system_scale.rules>/Area), 0)"]
			Distance = [0, "(&<contracts/system_scale.rules>/Scale) * 19000"]
		}
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_misc_discoverables.rules>"
		Overrides
		{
			Count = ["max(1, round(17 * (&<contracts/system_scale.rules>/Area), 0))", "max(1, round(20 * (&<contracts/system_scale.rules>/Area), 0))"]
			Distance = [0, "(&<contracts/system_scale.rules>/Scale) * 25000"]
			MinDistanceFromTags
			[
				[sun, "max((&<contracts/system_scale.rules>/Scale) * 6000, (&<contracts/system_scale.rules>/SunClearance))"]
				[station, "(&<contracts/system_scale.rules>/Scale) * 3000"]
				[ftl_gate, "(&<contracts/system_scale.rules>/Scale) * 3000"]
				[ftl_beacon, "(&<contracts/system_scale.rules>/Scale) * 1500"]
				[misc_discoverable, "(&<contracts/system_scale.rules>/Scale) * 6000"]
				[asteroid, 100]
			]
		}
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/sectors/sysgen_ftl_beacons.rules>/SubSpawners/0"
		Overrides
		{
			Count = "max(1, round(30 * (&<contracts/system_scale.rules>/Area), 0))"
			Distance = [0, "(&<contracts/system_scale.rules>/Scale) * 20000"]
			MinDistanceFromSiblings = "(&<contracts/system_scale.rules>/Scale) * 7500"
			MinDistanceFromTags
			[
				[sun, "max((&<contracts/system_scale.rules>/Scale) * 4500, (&<contracts/system_scale.rules>/SunClearance))"]
				[station, "(&<contracts/system_scale.rules>/Scale) * 7500"]
				[ftl_gate, "(&<contracts/system_scale.rules>/Scale) * 7500"]
				[asteroid, 100]
				[bounty, "(&<contracts/system_scale.rules>/Scale) * 1500"]
				[misc_discoverable, "(&<contracts/system_scale.rules>/Scale) * 1500"]
				[rare_asteroid, "(&<contracts/system_scale.rules>/Scale) * 1500"]
			]
		}
	}
