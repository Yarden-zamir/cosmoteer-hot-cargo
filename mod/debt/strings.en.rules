	LogFirmFmt = "The debt to the {0} reached {1}×."
	LogHostileFmt = "The debt to the {0} reached {1}×. They hunt you."

	// Heat panel (spec 1412). {0} balance, {1} faction, {2} ratio, {3} interest part, {4} collector part.
	PanelFmt = "DEBT {0} {1} ×{2}{3}{4}"
	PanelInterestFmt = "  +{0}% in {1}"
	PanelCollectorFmt = "  collector in {0}"
