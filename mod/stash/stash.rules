// Spec 970: a rumoured stash in open space. A trade station sells the rumour. C# reads this file (Stash/StashArea.cs) right after a
// system generates, rolls Stash.OfferChance, and spawns it with a random source seeded by the system, so the rest of the system
// keeps its layout. It is not part of the game rules tree, so "&/" references do not work here. Use "&<./Data/...>" paths.
// A rules change here needs a game restart.
Stash
{
	Spawners
	[
		{
			Type = None
			Tags = [hc_group_stash]
			Count = 1
			Distance = [3000, 12000]
			MinDistanceFromTags = [[sun, 6000], [station, 4000], [bounty, 3000], [hc_shady_ship, 5000]]
			MinDistanceFromNebulas = [[ion_storm, 1000]]
			SuppressLocationAssertions = true

			SubSpawners
			[
				{
					Type = Doodads
					Distance = 0
					ScaleFactor = 1200
					Tags = [hc_stash_site]
					DoodadType = cosmoteer.poi_target_area
					ShowOnlyInFog = true
					Undiscovered = true
					HideIfUnexplored = true
				}
				{
					Type = Mission
					Metatype = HotCargoStash
					SpawnAt = Tag
					SpawnAtTag = { Mode=Nearest; Tag=trade_station; }
					Faction = None
					Objectives
					[
						{
							Type = Sequential
							SubObjectives
							[
								{
									Type = HotCargoStash
									SiteTag = { Mode=Latest; Tag=hc_stash_site; }
									TriggerDistance = 1200
									// Spec 973: money × Stash.LootMoneyFactor (C#), and the fame of one standard mission.
									LootRewards
									[
										{
											Type = Money
											MoneyPerHighTier = &<./Data/modes/career/tier_tables.rules>/StandardMoneyPerTier
											RoundToMultiple = 500
										}
										{
											Type = Fame
											FamePerHighTier = &<./Data/modes/career/tier_tables.rules>/StandardFamePerTier
											MaxFamePerHighTier = &<./Data/modes/career/tier_tables.rules>/StandardMaxFamePerTier
										}
									]
								}
								{
									Type = ReceiveRewards
								}
							]
						}
					]
					Rewards
					[
						// Spec 100: the rumour costs a little, and a stash grab is quiet.
						{
							Type = HotCargoContract
							AcceptFee = 0.2
							FlatHeat = 2
							InformantChance = 0
						}
					]
				}
			]
		}
	]
}
