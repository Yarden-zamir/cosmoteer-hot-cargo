// Spec 970: a rumoured stash in open space. A trade station sells the rumour. The C# offer chance (Stash.OfferChance) sets SpawnChance
// before each system generates (StashArea.ChancePatch).
Stash
{
	Type = None
	Tags = [hc_group_stash]
	SpawnChance = 35%
	Count = 1
	Distance = [3000, 12000]
	MinDistanceFromTags = [[sun, 6000], [station, 4000], [bounty, 3000], [hc_shady_ship, 5000]]
	MinDistanceFromNebulas = [[ion_storm, 1000]]
	SuppressLocationAssertions = true

	SubSpawners
	[
		{
			Type = Doodads
			Distance = 0
			ScaleFactor = 1200
			Tags = [hc_stash_site]
			DoodadType = cosmoteer.poi_target_area
			ShowOnlyInFog = true
			Undiscovered = true
			HideIfUnexplored = true
		}
		{
			Type = Mission
			Metatype = HotCargoStash
			SpawnAt = Tag
			SpawnAtTag = { Mode=Nearest; Tag=trade_station; }
			Faction = None
			Objectives
			[
				{
					Type = Sequential
					SubObjectives
					[
						{
							Type = HotCargoStash
							SiteTag = { Mode=Latest; Tag=hc_stash_site; }
							TriggerDistance = 1200
							// Spec 973: money × Stash.LootMoneyFactor (C#), and the fame of one standard mission.
							LootRewards
							[
								{
									Type = Money
									MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
									RoundToMultiple = 500
								}
								{
									Type = Fame
									FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
									MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
								}
							]
						}
						{
							Type = ReceiveRewards
						}
					]
				}
			]
			Rewards
			[
				// Spec 100: the rumour costs a little, and a stash grab is quiet.
				{
					Type = HotCargoContract
					AcceptFee = 0.2
					FlatHeat = 2
					InformantChance = 0
				}
			]
		}
	]
}
