HotCargoAi
{
	// Log lines. {0} is the ship name.
	CallStartFmt = "{0} calls for help. Disruptor or EMP cuts it."
	CallCompleteFmt = "{0} got its call out. More ships inbound."
	CallStoppedFmt = "{0}'s call was cut off."
	JumpedOutFmt = "{0} jumped away."

	// Labels on the ship marker: player-facing threats only, never the enemy plan (spec 368).
	LabelCallingFmt = "CALLING HELP {0}%"
	LabelJumpFmt = "JUMP OUT {0}s"
}
