	LabelFleeing = "FLEEING"
	LabelRegroup = "REGROUPING"
	LabelCover = "IN COVER"

	// Mouseover line of a hostile ship (spec 368). {0} is the personality name, {1} the trait list, {2} the team role.
	PersonalityFmt = "{0}: {1}"
	PersonalityRoleFmt = "{0}: {1} ({2})"
	TraitKite = "kites"
