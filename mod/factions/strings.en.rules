	// Jump switch under ENGAGE, and blind jump damage.
	RelayClearFmt = "Relay jump: heat -{0:0}%"
	RelayWatchedFmt = "<bad>Watched relay: heat -{0:0}%</bad>"
	BlindOnFmt = "BLIND jump: heat -{0:0}%"
	BlindTipFmt = "<b>Relay or blind jump</b>\nEvery jump cuts your heat. The corporation watches the relays:\n  relay with hunters near it: -{0:0}%\n  relay with no hunter near it: -{1:0}%\n  blind jump: -{2:0}%\nA blind jump costs ×{3:0.##} fuel and spins up ×{4:0.##} longer. Damage to a drive restarts the spin-up.\nEach ship has a {5:0}% chance to arrive hurt: {6} parts lose {7:0}% health.\nClick to switch. The switch holds for one jump."
