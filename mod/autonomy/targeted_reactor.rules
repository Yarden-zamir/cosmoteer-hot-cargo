// Targeted reactor (spec 1053). reactor_small with half its battery output, sent straight into the BatteryStorage of each part
// that touches one of its sides (one vanilla ResourceStorageProxy per outside edge tile). No crew can take power from it, and
// crew cannot walk through it. Art: sprites/targeted_reactor (tools/sprites/make_sprites.py): a sealed core with an emitter toward each side.
Part : <./Data/ships/terran/reactor_small/reactor_small.rules>/Part
{
	NameKey = "HotCargoAutonomy/TargetedReactor"
	IconNameKey = "HotCargoAutonomy/TargetedReactorIcon"
	ID = yarden_zamir.targeted_reactor
	OtherIDs = []
	DescriptionKey = "HotCargoAutonomy/TargetedReactorDesc"
	SelectionTypeID = "yarden_zamir.targeted_reactor"
	Resources
	[
		[steel, 32]
		[coil, 60]
		[enriched_uranium, 4]
	]
	// No provides_power: crew and the vanilla AI do not look for power here.
	TypeCategories = [reactor]
	CrewSpeedFactor = 0
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	EditorIcon
	{
		Texture
		{
			File = "sprites/targeted_reactor/icon.png"
			SampleMode = Linear
		}
		Size = [56, 56]
	}
	Components : ^/0/Components
	{
		// Kept for the vanilla battery art and overclock values; nothing fills it and crew cannot take from it.
		BatteryStorage : ^/0/BatteryStorage
		{
			StartingResources = 0
			SuppliesResources = false
		}
		BatteryProducer : ^/0/BatteryProducer
		{
			ToStorage = AdjacentPower
			// Half of reactor_small: 500 every 2/3 s = 750 battery per second.
			ToQuantity : ^/0/ToQuantity
			{
				BaseValue = 500
			}
			MinToQuantityForConversion = 1
		}
		AdjacentPower
		{
			Type = MultiResourceStorage
			ResourceType = battery
			AddMode = PrioritizeMostEmptyCapacity
			ResourceStorages = [PowerUp0, PowerUp1, PowerRight0, PowerRight1, PowerDown0, PowerDown1, PowerLeft0, PowerLeft1]
		}
		PowerUp0
		{
			Type = ResourceStorageProxy
			ResourceType = battery
			PartLocation = [0, -1]
			ComponentID = BatteryStorage
			PartCriteria
			{
				ExcludeCategories = [provides_power]
			}
		}
		PowerUp1 : PowerUp0 { PartLocation = [1, -1] }
		PowerRight0 : PowerUp0 { PartLocation = [2, 0] }
		PowerRight1 : PowerUp0 { PartLocation = [2, 1] }
		PowerDown0 : PowerUp0 { PartLocation = [0, 2] }
		PowerDown1 : PowerUp0 { PartLocation = [1, 2] }
		PowerLeft0 : PowerUp0 { PartLocation = [-1, 0] }
		PowerLeft1 : PowerUp0 { PartLocation = [-1, 1] }

		// Own art (sprites/targeted_reactor, tools/sprites/make_sprites.py). These names replace the vanilla visual components.
		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels [
					{ File = "sprites/targeted_reactor/floor.png"; Size = [2, 2] }
					{ File = "sprites/targeted_reactor/floor_33.png"; Size = [2, 2] }
					{ File = "sprites/targeted_reactor/floor_66.png"; Size = [2, 2] }
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{ AnimationFiles [ "sprites/targeted_reactor/doodads_on1.png", "sprites/targeted_reactor/doodads_on2.png", "sprites/targeted_reactor/doodads_on3.png", "sprites/targeted_reactor/doodads_on4.png" ]; Size = [2, 2]; AnimationInterval = 0.25 }
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels [ { File = "sprites/targeted_reactor/doodads_off.png"; Size = [2, 2] } ]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels [ { File = "sprites/targeted_reactor/lights.png"; Size = [2, 2] } ]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels [
					{ File = "sprites/targeted_reactor/walls.png"; Size = [2, 2] }
					{ File = "sprites/targeted_reactor/walls_33.png"; Size = [2, 2] }
					{ File = "sprites/targeted_reactor/walls_66.png"; Size = [2, 2] }
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels [
					{ File = "sprites/targeted_reactor/roof.png"; NormalsFile = "sprites/targeted_reactor/roof_normals.png"; Size = [2, 2] }
					{ File = "sprites/targeted_reactor/roof_33.png"; NormalsFile = "sprites/targeted_reactor/roof_normals_33.png"; Size = [2, 2] }
					{ File = "sprites/targeted_reactor/roof_66.png"; NormalsFile = "sprites/targeted_reactor/roof_normals_66.png"; Size = [2, 2] }
				]
			}
		}
		ReactorLights_NonOverclocked_Components { Type = ToggledComponents; Toggle = IsOperational; Components {} }
		ReactorLights_Overclocked_Components { Type = ToggledComponents; Toggle = IsOperational; Components {} }
		BatterySprites { Type = ToggledComponents; Toggle = IsOperational; Components {} }
		Blueprints
		{
			Type = BlueprintSprite
			File = "sprites/targeted_reactor/blueprints.png"
			Size = [2, 2]
		}
	}
}
