// Computer (spec 1050, 1051). 2x1: command points and sensors without crew, like control_room_small. It needs power.
// It counts as 1 crew member in the one crewed part in front of its arrow (C#, Autonomy.cs). Art: sprites/computer, drawn by
// tools/sprites/make_sprites.py: a server cabinet with a screen strip at the front (the top edge at rotation 0), the side it serves.
Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "HotCargoAutonomy/Computer"
	IconNameKey = "HotCargoAutonomy/ComputerIcon"
	ID = yarden_zamir.computer
	EditorGroup = "Control"
	DescriptionKey = "HotCargoAutonomy/ComputerDesc"
	SelectionTypeID = "yarden_zamir.computer"
	Resources
	[
		[steel, 16]
		[coil, 40]
		[processor, 4]
	]
	AIValueFactor = 5
	Size = [2, 1]
	IsRotateable = true
	MaxHealth = 2000
	ContiguityOriginPriority = 1
	SignificanceToggle = ScorchedToggle
	TypeCategories = [command, uses_power]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	// A machine: crew do not walk through it.
	CrewSpeedFactor = 0
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	EditorIcon
	{
		Texture
		{
			File = "sprites/computer/icon.png"
			SampleMode = Linear
		}
		Size = [64, 32]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorage, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		// Filled by a targeted reactor next to it, or by crew of a crewed ship.
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/ControlRoom_Supply
			ResupplyThreshold = 500
			OperationalToggle = ConsumptionToggle
			AllowNonContiguousCrewSearch = true
		}
		PowerDrain
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			FromStorage = BatteryStorage
			FromQuantity = 1000
			MinFromQuantityForConversion = 1
			Interval = 60
		}

		CommandProvider
		{
			Type = CommandProvider
			OperationalToggle = IsOperational
			CommandPoints = 50
		}
		Sensor
		{
			Type = Sensor
			OperationalToggle = IsOperational
			SightRadius = 400
			RadarRadius = 1800
		}

		Graphics
		{
			Type = Graphics
			Location = [1, 0.5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels [
					{ File = "sprites/computer/floor.png"; Size = [2, 1] }
					{ File = "sprites/computer/floor_33.png"; Size = [2, 1] }
					{ File = "sprites/computer/floor_66.png"; Size = [2, 1] }
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{ AnimationFiles [ "sprites/computer/doodads_on1.png", "sprites/computer/doodads_on2.png" ]; Size = [2, 1]; AnimationInterval = 0.6 }
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels [ { File = "sprites/computer/doodads_off.png"; Size = [2, 1] } ]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels [ { File = "sprites/computer/lights.png"; Size = [2, 1] } ]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels [
					{ File = "sprites/computer/walls.png"; Size = [2, 1] }
					{ File = "sprites/computer/walls_33.png"; Size = [2, 1] }
					{ File = "sprites/computer/walls_66.png"; Size = [2, 1] }
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels [
					{ File = "sprites/computer/roof.png"; NormalsFile = "sprites/computer/roof_normals.png"; Size = [2, 1] }
					{ File = "sprites/computer/roof_33.png"; NormalsFile = "sprites/computer/roof_normals_33.png"; Size = [2, 1] }
					{ File = "sprites/computer/roof_66.png"; NormalsFile = "sprites/computer/roof_normals_66.png"; Size = [2, 1] }
				]
			}
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1, 0.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [1, 0.5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 0.5]
			Indicators
			[
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1, 2]
				}
				{
					Toggle = PowerToggle
					AtlasSprite { File = &/INDICATORS/PowerOff; Size = [1, 1] }
					HidesIndicators = [2]
				}
				{
					Toggle = BatteryStorage
					AtlasSprite { File = &/INDICATORS/NoPower; Size = [1, 1] }
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "sprites/computer/blueprints.png"
			Size = [2, 1]
		}
	}

	Stats
	{
		PowerUsageContinuousMinutes = (&~/Part/Components/PowerDrain/FromQuantity) / (&~/Part/Components/PowerDrain/Interval) / 1000 * 60
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		SightRange = &~/Part/Components/Sensor/SightRadius
		RadarRange = &~/Part/Components/Sensor/RadarRadius
	}
}
