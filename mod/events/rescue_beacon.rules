// Rescue Beacon (spec 1146): fire it to call a tug that tows the ship to the nearest friendly station, for a fee and some heat.
// Trade stations sell it in their comms (events.rules, rescue_beacon_sale). Sprites are the vanilla processor sprites with a tint.
ID = yarden_zamir.rescue_beacon
NameKey = "HotCargoItems/RescueBeacon"
PluralNameKey = "HotCargoItems/RescueBeaconPlural"
DescriptionKey = "HotCargoItems/RescueBeaconDesc"
// Not in the station trade lists (the comms line sells it); 1, not 0, because some vanilla code divides by it.
BuyPrice = 1
MaxPerNugget = 1
MaxStackSize = 1
// Shares the processor key, so storage parts get no extra supply job.
FlexGridPriorityKey = "flex_grid_processor"
FlexGridDefaultPriority = 1
DropRates
{
	StorageDestroyed = 50%
	StorageSalvaged = 100%
	CrewKilled = 100%
}
Rarity = Unique

TINT = [255, 170, 40]

Icon
{
	Texture
	{
		File = "./Data/resources/processor/icon.png"
		MipLevels = max
	}
	Size = [64, 64]
	VertexColor = &~/TINT
}

Overlay
{
	Texture
	{
		File = "./Data/resources/processor/overlay.png"
		SampleMode = Linear
		MipLevels = max
	}
	Size = [1, 1]
	VertexColor = &~/TINT
}

NuggetSprite
{
	File = "./Data/resources/processor/processor.png"
	NormalsFile = "./Data/resources/processor/processor_normals.png"
	Size = [1, 1]
	Offset = [.25+6/64, 0]
	UVRotation = 1
	VertexColor = &~/TINT
}

StackSprites
[
	{
		File = "./Data/resources/processor/processor_stack_1.png"
		Size = [1, 1]
		VertexColor = &~/TINT
	}
]

StackReceiveMediaEffects = &/COMMON_EFFECTS/ProcessorDeliver
StackPickupMediaEffects = &/COMMON_EFFECTS/ProcessorPickup
NuggetPickupMediaEffects = &/COMMON_EFFECTS/NuggetPickup

// Spec 1146: the C# handler (Events/RescueBeacon.cs) runs the rescue; the button tooltip shows the fee and the heat.
HotCargoActions
[
	{
		ID = fire
		NameKey = "HotCargoItems/FireRescue"
		ToolTipKey = "HotCargoItems/FireRescueTip"
		Handler = rescue
	}
]
