// Hot Cargo events (EVENTS.md): signal POIs in each system, and the mission types that event outcomes start.
// Event content lives in events/events.rules and events/spawns.rules, which C# reads; they need no Actions.
{
	Action = Add
	AddTo = "<modes/career/sectors/sector_basic/sector_basic.rules>/Sector/SystemGenerator/Spawners"
	ToAdd = &<events/sysgen_events.rules>
}
{
	Action = Add
	AddTo = "<resources/resources.rules>/Resources"
	ToAdd = &<events/sealed_case.rules>
}
{
	Action = Add
	AddTo = "<resources/resources.rules>/Resources"
	ToAdd = &<events/flight_recorder.rules>
}
// Spec 1115, 1116: what a Sealed Case holds.
{
	Action = Add
	AddTo = "<resources/resources.rules>/Resources"
	ToAdd = &<events/opened_case.rules>
}
{
	Action = Add
	AddTo = "<resources/resources.rules>/Resources"
	ToAdd = &<events/access_codes.rules>
}
{
	Action = Add
	AddTo = "<resources/resources.rules>/Resources"
	ToAdd = &<events/tracer_beacon.rules>
}
// Spec 1147: the Rescue Beacon.
{
	Action = Add
	AddTo = "<resources/resources.rules>/Resources"
	ToAdd = &<events/rescue_beacon.rules>
}
{
	Action = Overrides
	OverrideIn = "<modes/career/mission_metatypes.rules>"
	Overrides
	{
		HotCargoEventRivals
		{
			NameKey = "HotCargoEventMissions/Rivals"
			DescriptionKey = "HotCargoEventMissions/RivalsDesc"
			CategoryID = encounter
		}
		HotCargoEventSiege
		{
			NameKey = "HotCargoEventMissions/Siege"
			DescriptionKey = "HotCargoEventMissions/SiegeDesc"
			CategoryID = encounter
		}
		HotCargoEventBounty
		{
			NameKey = "HotCargoEventMissions/Bounty"
			DescriptionKey = "HotCargoEventMissions/BountyDesc"
			CategoryID = encounter
		}
		HotCargoEventTow
		{
			NameKey = "HotCargoEventMissions/Tow"
			DescriptionKey = "HotCargoEventMissions/TowDesc"
			CategoryID = encounter
		}
		HotCargoRescueTow
		{
			NameKey = "HotCargoEventMissions/RescueTow"
			DescriptionKey = "HotCargoEventMissions/RescueTowDesc"
			CategoryID = encounter
		}
		HotCargoCourier
		{
			NameKey = "HotCargoEventMissions/Courier"
			DescriptionKey = "HotCargoEventMissions/CourierDesc"
			CategoryID = deliveries
		}
	}
}
