HotCargoEventMissions
{
	Rivals = "Rival Crew"
	RivalsDesc = "Rival thieves want your cargo. Every station in the {mission_location} system posts a bounty on them. Take them apart and collect {money}."
	Siege = "Freighter Under Fire"
	Bounty = "Bounty Hunters"
	BountyDesc = "Local bounty hunters want the price on your hull. Each one you put down pays its own bounty in the {mission_location} system: {money}."
	Tow = "Tow Job"
	TowDesc = "A freighter with a dead drive needs a tow to the nearest station in the {mission_location} system. Pull it in with a tractor beam and keep it in one piece. The crew pays {money} on arrival."
	TowFmt = "Tow {0} to the nearest station"
	HandOverFmt = "Hand the {0} {1} to {2}: hail it"
	HandOverLostFmt = "The {0} is lost. The job failed."
	OkaforPickupFmt = "Get Okafor off {0}: hail it"
	SealedCase = "Sealed Case"
	SealedCasePlural = "Sealed Cases"
	SealedCaseDesc = "A locked case for a Courier Job. Hand it to the contact. Do not open it."
	Courier = "Courier Job"
	CourierDesc = "A sealed case, no questions. Fly it to the contact on the far side of the {mission_location} system within {time_limit_minutes} minutes, then come back for {money}. Good pay, quiet job: little fame, little attention."
	SiegeDesc = "Raiders have a freighter pinned in the {mission_location} system, and its shields are failing. Drive them off before time runs out, and the crew pays {money}."
}

