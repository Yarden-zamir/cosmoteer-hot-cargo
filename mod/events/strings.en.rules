HotCargoEventMissions
{
	Rivals = "Rival Crew"
	RivalsDesc = "Another crew of thieves wants your cargo. Their own bounty is posted on every station in the {mission_location} system. Take them apart and collect {money}."
	Siege = "Freighter Under Fire"
	Bounty = "Bounty Hunters"
	BountyDesc = "Local bounty hunters want the reward on your hull. Every one you put down has a price of its own in the {mission_location} system: {money}."
	Courier = "Courier Job"
	CourierDesc = "A sealed case, no questions. Fly it to the contact on the far side of the {mission_location} system within {time_limit_minutes} minutes, then come back to collect {money}. "\
	              "The pay is good and the job is quiet: little fame, little attention."
	SiegeDesc = "Raiders have a freighter pinned in the {mission_location} system. Its shields will not hold for long. Drive them off before time runs out, and the crew pays {money}."
}
