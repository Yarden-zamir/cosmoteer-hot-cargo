	// The run's one relic ship (spec 765). It opens when a ship comes close, and again on each return until the crate is taken.
	{
		ID = relic_ship
		Trigger = Relic
		MaxPerRun = 0
		Need { NotFlags = [relic_taken] }
		Title = "Dead Courier"
		Text = "The hull is cold, but your vault is sure: a crate like yours is aboard. Another crew stole from the corporation and never made it out."
		Choices
		[
			{
				Text = "Recover the crate."
				Need { VaultSpace = 1 }
				Outcomes
				[
					{ Weight = 85; Text = "You carry the crate home. Your vault takes it like it was always yours."; Tech = 1; SetFlags = [relic_taken] }
					{ Weight = 15; WeightPerHeat = 0.1; Text = "You get the crate, but the corporation left a watcher on the wreck. It wakes as you leave."; Tech = 1; SetFlags = [relic_taken]; Spawn = CorporatePatrol }
				]
			}
			{
				Text = "Leave it for now."
				Outcomes [ { Text = "The crate will wait. Its owners are not coming back." } ]
			}
		]
	}

	// ---- Hail lines (spec 769): extra Hot Cargo lines in the comms of stations and faction ships. Once per ship and line.

	{
		ID = off_books
		Trigger = Hail
		HailTarget = Station
		HailLine = "Sell a crate off the books."
		MaxPerRun = 0
		Need { Tech = 2 }
		Title = "Off the Books"
		Text = "The dock officer lowers her voice. \"No trade log, no tax, no questions. We pay under market, but the sale never happened.\""
		Options
		[
			{ Text = "Crates to sell"; Pay = Tech; MinUnits = 1; MaxUnits = 3; Effect { MoneyTech = 0.85; Heat = -10 } }
		]
		Choices
		[
			{
				// Spec 811: each crate pays 0.85 tech value and cuts heat by 10, as one crate did before.
				Text = "Sell the crates."
				NeedPoints = 1
				Need { Tech = 1 }
				Outcomes [ { Text = "The sale never happened. Neither did your last port call." } ]
			}
			{
				Text = "Changed my mind."
				Outcomes [ { Text = "\"Suit yourself.\"" } ]
			}
		]
	}

	// Spec 1115: the codes from an opened Sealed Case sell at a station, a clear deal at half a standard mission's pay.
	{
		ID = codes_fence
		Trigger = Hail
		HailTarget = Station
		HailLine = "Sell corporate access codes."
		MaxPerRun = 0
		Need { Resources = [{ ID = yarden_zamir.access_codes; Amount = 1 }] }
		Title = "Off the Books"
		Text = "The dock officer reads the first line of the codes and stops. \"I know a buyer. Half a job's pay, no questions.\""
		Choices
		[
			{
				Text = "Sell the codes."
				Cost { Resources = [{ ID = yarden_zamir.access_codes; Amount = 1 }] }
				Outcomes [ { Text = "The codes change hands. Nobody logs it."; Money = 0.5 } ]
			}
			{
				Text = "Not now."
				Outcomes [ { Text = "\"Come back when you need the money.\"" } ]
			}
		]
	}

	// Spec 1147: stations sell the Rescue Beacon, a clear deal. Limit: the price is paid even when the hold has no room (the result
	// line says so); revisit if players lose money this way.
	{
		ID = rescue_beacon_sale
		Trigger = Hail
		HailTarget = Station
		HailLine = "Buy a rescue beacon."
		MaxPerRun = 0
		Title = "Rescue Beacon"
		Text = "The dock officer slides a scuffed beacon across. \"Fire it when you're dead in space. A tug tows you to the nearest friendly dock. The tug crew bills you, and the whole sector hears the call.\""
		Choices
		[
			{
				Text = "Buy the beacon."
				Cost { Money = 0.3 }
				Outcomes [ { Text = "The beacon goes into your hold."; Resources = [{ ID = yarden_zamir.rescue_beacon; Amount = 1 }] } ]
			}
			{
				Text = "Not now."
				Outcomes [ { Text = "\"Hope you never need one.\"" } ]
			}
		]
	}

	// Spec 46: the gamble ("ask nicely") is a world action now, a sensor array that listens to the ship (spec 1122). This page is the clear deal.
	{
		ID = hunter_intel
		Trigger = Hail
		HailTarget = FactionShip
		HailLine = "Ask about hunters nearby."
		MaxPerRun = 0
		Need { MinHeat = 10 }
		Title = "Patrol Chatter"
		Text = "The pilot shrugs. \"Corporate ships? We see them. Information costs, though.\""
		Choices
		[
			{
				Text = "Pay for their patrol logs."
				Cost { Money = 0.2 }
				Outcomes [ { Text = "They send the corporate patrol routes. You plot around them."; Heat = -8 } ]
			}
			{
				Text = "Never mind."
				Outcomes [ { Text = "The channel closes." } ]
			}
		]
	}

	// Courier Job hand-over (spec 1102): the line shows on the job's contact while the fleet holds the case, sealed or opened (spec 1117).
	// The cost takes the case; HandOver completes the job's hand-over objective. Opening happens in the hold (spec 1115), not here.
	// An opened case (spec 1118): the contact does not notice 40, notices and pays 20 % less 30, turns hostile 15 + 0.15 x heat,
	// leaves 15 + 0.1 x heat. At heat 100: 40 / 30 / 30 / 25.
	{
		ID = courier_handover
		Trigger = Hail
		HailTarget = Contact
		HailLine = "Hand over the case."
		MaxPerRun = 0
		Title = "The Hand-Over"
		Text = "A hatch opens, and a gloved hand waits for the case. \"You didn't open it. Right?\""
		Choices
		[
			{
				Text = "Hand over the sealed case."
				// The cost is the need: the choice hides while no sealed case is aboard.
				HideIfUnmet = true
				Cost { Resources = [{ ID = yarden_zamir.sealed_case; Amount = 1 }] }
				Outcomes [ { Text = "The hatch closes. Your pay waits at the station."; HandOver = true } ]
			}
			{
				Text = "Hand over the opened case."
				HideIfUnmet = true
				Cost { Resources = [{ ID = yarden_zamir.opened_case; Amount = 1 }] }
				Outcomes
				[
					{ Weight = 40; Text = "The contact does not check the seal. The hatch closes. Your pay waits at the station."; HandOver = true; Chat = true }
					{ Weight = 30; Text = "The contact sees the broken seal. \"You looked. That comes out of your pay.\" The station pays 20 % less."; HandOver = true; HandOverPay = 0.8; Chat = true }
					{ Weight = 15; WeightPerHeat = 0.15; Text = "The contact sees the broken seal, keeps the case, and opens fire. The job failed."; ContactTurns = Hostile; Chat = true }
					{ Weight = 15; WeightPerHeat = 0.1; Text = "The contact sees the broken seal and jumps away with the case. The job failed."; ContactTurns = Leaves; Chat = true }
				]
			}
			{
				Text = "Not yet."
				Outcomes [ { Text = "\"Don't make me wait long.\"" } ]
			}
		]
	}

	// Extraction pickup (The Quiet Defector, spec 1105): the transport's comms, after its escorts are gone. HandOver ends the pickup step.
	{
		ID = okafor_pickup
		Trigger = Hail
		HailTarget = Contact
		HailLine = "Get Okafor out."
		MaxPerRun = 0
		Title = "The Quiet Defector: The Airlock"
		Text = "The escorts are scrap. Sabine Okafor waits at the transport's airlock in a pressure suit. \"Get me out before they wipe the logs.\" Behind her, the hold is stacked with processor crates."
		Choices
		[
			{
				Text = "Bring her aboard."
				Need { Bunks = 1 }
				Outcomes [ { Text = "She crosses on a tether with one bag and takes a bunk."; Crew = 1; HandOver = true } ]
			}
			{
				Text = "Not yet."
				Outcomes [ { Text = "\"Hurry. Somebody will miss me.\"" } ]
			}
		]
	}

	// The Black Box hand-over (spec 1107): the station's broker takes the recorder. The Playback page (chains) follows at the station.
	{
		ID = blackbox_broker
		Trigger = Hail
		HailTarget = Contact
		HailLine = "Hand over the flight recorder."
		MaxPerRun = 0
		Need { Resources = [{ ID = yarden_zamir.flight_recorder; Amount = 1 }] }
		Title = "The Black Box: The Broker"
		Text = "The broker's man waits at the airlock with a padded case. Your navigator asks for one minute with the recorder first."
		Choices
		[
			{
				Text = "Hand it over."
				Cost { Resources = [{ ID = yarden_zamir.flight_recorder; Amount = 1 }] }
				Outcomes [ { Text = "The case snaps shut. Your navigator got the logs, and your pay waits at the station."; HandOver = true } ]
			}
			{
				Text = "Not yet."
				Outcomes [ { Text = "\"The broker doesn't like to wait.\"" } ]
			}
		]
	}

	// Prototype Retrieval hand-over (spec 1108): the broker at the station takes the core. Haggling risks a tip-off.
	{
		ID = prototype_broker
		Trigger = Hail
		HailTarget = Contact
		HailLine = "Hand over the prototype core."
		MaxPerRun = 0
		Need { Resources = [{ ID = yarden_zamir.prototype_core_cargo; Amount = 1 }] }
		Title = "Prototype Retrieval: The Broker"
		Text = "The broker runs a scanner over the core twice. \"Intact. Good. My client will be pleased.\""
		Choices
		[
			{
				Text = "Hand it over."
				Cost { Resources = [{ ID = yarden_zamir.prototype_core_cargo; Amount = 1 }] }
				Outcomes [ { Text = "The core goes into a shielded crate. Your pay waits at the station."; HandOver = true } ]
			}
			// Spec 1121: a clear deal, not a gamble. More money, and the broker sells your hull number to make it back.
			{
				Text = "Ask for more. The broker will make it back off you."
				Cost { Resources = [{ ID = yarden_zamir.prototype_core_cargo; Amount = 1 }] }
				Outcomes [ { Text = "The broker adds to the price, then sells your hull number to the corporation for the difference."; Money = 0.5; Heat = 10; HandOver = true } ]
			}
			{
				Text = "Not yet."
				Outcomes [ { Text = "\"Don't take it far.\"" } ]
			}
		]
	}

	// Repossession hand-over (spec 1110): the bank takes the freighter at the station, once it is close and no player crew is aboard.
	{
		ID = repo_handover
		Trigger = Hail
		HailTarget = Contact
		HailLine = "Hand over the repossessed freighter."
		MaxPerRun = 0
		Title = "Repossession: The Bank"
		Text = "The bank's dock crew wait with a docking clamp. \"Bring it alongside and clear your people off. We take it from there.\""
		Choices
		[
			{
				Text = "Hand over the freighter."
				Need { HandOverReady = true }
				Outcomes [ { Text = "The clamps lock on, and the bank's pilots take the helm. Your pay waits at the station."; HandOver = true } ]
			}
			{
				Text = "Not yet."
				Outcomes [ { Text = "\"The meter is running.\"" } ]
			}
		]
	}

	// ---- Station

	{
		ID = the_fence
		Trigger = Station
		Need { Tech = 2 }
		Title = "The Fence"
		Text = "A message arrives on a band the station does not officially have. \"Heard you carry something hot. I pay below market, but I sell it on in pieces, three systems the other way. The corporation chases the pieces, not you.\""
		Options
		[
			{ Text = "Crates to sell"; Pay = Tech; MinUnits = 1; MaxUnits = 3; Effect { MoneyTech = 0.75; Heat = -15 }; Once { Heat = -5 } }
		]
		Choices
		[
			{
				// Spec 811: each crate pays 0.75 tech value; heat -20 for the first and -15 for each more, as one or two crates did before.
				Text = "Sell through the fence."
				NeedPoints = 1
				Need { Tech = 1 }
				Outcomes [ { Text = "The crates leave on a garbage scow. Credits arrive an hour later, and so does a lot of corporate traffic, somewhere else." } ]
			}
			{
				Text = "Not today."
				Outcomes [ { Text = "\"Offer stands. For now.\"" } ]
			}
		]
	}

	{
		ID = smuggler_den
		Trigger = Station
		Need { MinSector = 2; MinHeat = 20 }
		Title = "Smugglers' Den"
		Text = "Behind the ore bay, a smuggler crew runs a quiet business: transponder swaps, hull repaints and long silences. \"We can make you somebody else for a while,\" their boss says. \"It is not cheap.\""
		Choices
		[
			{
				Text = "Pay for a new transponder and a repaint."
				Cost { Money = 1 }
				Outcomes
				[
					{ Weight = 85; Text = "You leave with a new name and a dull grey hull. The corporate net loses you for a while."; Heat = -35 }
					{ Weight = 15; WeightPerHeat = 0.15; Text = "The boss takes your money, then sells your new name to the corporation the same day."; Heat = 10 }
				]
			}
			{
				Text = "Trade a crate for the full treatment, no questions."
				Need { Tech = 1 }
				Cost { Tech = 1 }
				Outcomes [ { Text = "The boss opens the crate, whistles, and shuts it fast. \"You were never here.\""; Heat = -50 } ]
			}
			{
				Text = "Leave."
				Outcomes [ { Text = "\"Come back when they're closer,\" the boss says. \"You will.\"" } ]
			}
		]
	}

	{
		ID = informant
		Trigger = Station
		Need { MinSector = 2 }
		Title = "The Informant"
		Text = "A dock worker falls into step beside your crew. \"Corporate hunters asked about you an hour ago. For a price, I can tell you where they plan to wait.\""
		Choices
		[
			{
				Text = "Pay for the information."
				Cost { Money = 0.3 }
				Outcomes [ { Text = "The routes check out. You plot a course around the ambush."; Heat = -15 } ]
			}
			{
				Text = "Lean on him until he talks."
				Need { Crew = 3 }
				Outcomes
				[
					{ Weight = 55; Text = "He talks fast, and for free."; Heat = -15 }
					{ Weight = 45; Text = "He talks. Then he goes and talks to the corporation."; Heat = 15 }
				]
			}
			{
				Text = "Tell him to get lost."
				Outcomes [ { Text = "He shrugs and disappears into the crowd." } ]
			}
		]
	}

	// ---- Signal

	{
		ID = derelict_survey
		Trigger = Signal
		Title = "Derelict Survey Ship"
		Text = "The signal leads to a survey ship, dark and slowly spinning. The hull is intact, but the reactor housing glows a faint, unhealthy blue."
		Choices
		[
			{
				Text = "Send a salvage team aboard."
				Need { Crew = 2 }
				Outcomes
				[
					{ Weight = 50; Text = "The team strips the cargo hold clean."; Resources = [{ ID = steel; Amount = 40; PerTier = 8 }, { ID = coil; Amount = 10; PerTier = 2 }] }
					{ Weight = 25; Text = "Deep in the computer core: survey data that any station will buy."; Money = 0.6 }
					{ Weight = 25; Text = "The reactor flares while the team is aboard. They get out, but not all of them."; Crew = -1; Resources = [{ ID = steel; Amount = 20; PerTier = 4 }] }
				]
			}
			{
				Text = "Cut it open from outside."
				Outcomes
				[
					{ Weight = 60; Text = "Your cutters peel armor plating off by the ton."; Resources = [{ ID = steel; Amount = 30; PerTier = 6 }] }
					{ Weight = 40; Text = "The reactor housing ruptures, and the blast catches your hull."; HullDamage = 0.3 }
				]
			}
			{
				Text = "Leave it."
				Outcomes [ { Text = "Some things are better left dark." } ]
			}
		]
	}

	{
		ID = old_handshake
		Trigger = Signal
		Title = "Old Handshake"
		Text = "The signal repeats a corporate authentication request. It is old, very old. In your vault, the stolen tech starts to hum in answer."
		Choices
		[
			{
				Text = "Let the stolen tech answer."
				Need { Tech = 1; VaultSpace = 1 }
				Outcomes
				[
					{ Weight = 35; Text = "A hidden cache opens. Inside: a sealed crate, the same make as the ones in your vault."; Tech = 1 }
					{ Weight = 35; Text = "A dormant security drone powers up and turns toward you."; Spawn = Drone }
					{ Weight = 30; Text = "The answer goes out on every corporate band at once."; Heat = 20 }
				]
			}
			{
				Text = "Record it and sell the recording."
				Outcomes [ { Text = "A data broker pays well for old corporate codes."; Money = 0.3 } ]
			}
			{
				Text = "Move on."
				Outcomes [ { Text = "The request repeats behind you, patient as ever." } ]
			}
		]
	}

	{
		ID = hunter_wreck
		Trigger = Signal
		Need { MinSector = 3 }
		Title = "Hunter Wreck"
		Text = "A corporate hunter, freshly dead. Its hull is torn open by weapons you do not recognize. Its flight recorder is still blinking."
		Choices
		[
			{
				Text = "Pull the flight recorder."
				Need { Crew = 1 }
				Outcomes
				[
					{ Weight = 75; Text = "The recorder holds the hunters' search pattern for this sector. You plot around it."; Heat = -25 }
					{ Weight = 25; Text = "The recorder was wired to a charge. You keep the data, and some of the shrapnel."; Heat = -10; HullDamage = 0.2 }
				]
			}
			{
				Text = "Strip its armor."
				Outcomes [ { Text = "Corporate plating, still warm."; Resources = [{ ID = steel; Amount = 40; PerTier = 8 }, { ID = tristeel; Amount = 4; PerTier = 1 }] } ]
			}
			{
				Text = "Leave. Whatever killed it may come back."
				Outcomes [ { Text = "You leave the wreck to its silence." } ]
			}
		]
	}

	// The fallback, so that a signal always shows something.
	{
		ID = ghost_signal
		Trigger = Signal
		Weight = 2
		MaxPerRun = 0
		Title = "Ghost Signal"
		Text = "The signal fades as you arrive. Whatever sent it is gone. Only scattered debris remains."
		Choices
		[
			{
				Text = "Sweep the debris."
				Outcomes [ { Text = "Your crew collects what is worth collecting."; Resources = [{ ID = steel; Amount = 10; PerTier = 2 }] } ]
			}
			{
				Text = "Move on."
				Outcomes [ { Text = "You leave the debris to drift." } ]
			}
		]
	}
]
