// Hot Cargo events (EVENTS.md). C# reads this file (Events/EventLibrary.cs) on first use; a change needs a game restart.
// Units:
//   Money, Cost.Money, Need.Money: event money units. 1 = the middle of a standard mission's pay at the sector tier, with the reward factors.
//     On the default economy, 1 unit at tier 1 is about 10,000 credits, the value of one Stolen Tech in sector 1.
//   MoneyTech: × the tech value when the event opened.  Fame: × a standard mission's fame (fame adds heat through the normal rule).
//   Heat: heat points (stages at Heat.Stages, by default 40, 75, 100).  Tech, Crew: units.  Resources: { ID; Amount; PerTier } with PerTier added per tier above 1.
// A choice's Cost is paid for sure and is shown on its button. A Need greys the button out with the reason, or hides it (HideIfUnmet).
// Outcome weights: Weight + WeightPerHeat × heat + WeightPerTech × fleet tech, never below 0.
// Reputation: × a standard mission's reputation, with the faction that controls the system.  BuyerPrice: multiplies the Buyer price for the run.
// Need extras: FlagAges = [{ Flag; MinSectors }], MinSectorsLeft / MaxSectorsLeft (sectors before the Buyer).  Cost.MoneyPerHeat: money units per heat point.
// Text tokens: {crates} = the live fleet tech count ("1 crate", "7 crates"). Do not write counts that live elsewhere
// (spawn counts in spawns.rules, the starting tech): they drift. Counts from the same choice (its Cost) are fine.
// Spawn names are generators in spawns.rules. Next opens another event as a follow-up page. Flags carry a story between events.
Events
[
	// ---- Arrival

	{
		ID = distress_beacon
		Trigger = Arrival
		Title = "Distress Beacon"
		Text = "A looped distress call cuts through the static: a mining tender with a failing reactor and six crew still aboard. The voice sounds tired. The beacon is close."
		Choices
		[
			{
				Text = "Answer the call."
				Outcomes
				[
					{ Weight = 40; Text = "The crew is real and very grateful. They pay you from the ore money and promise to forget your hull number."; Money = 0.4; Fame = 0.3 }
					{ Weight = 20; Text = "You get them off before the reactor goes. One of their engineers asks to stay. \"You run fast. I like fast.\""; Crew = 1; Fame = 0.3 }
					{ Weight = 20; Text = "The tender is an empty hull with a transmitter bolted to it. Pirate ships drop out of the dark."; Spawn = Raiders }
					{ Weight = 20; Text = "The reactor story was a panic. The real trouble is a dead drive."; Next = broken_down }
				]
			}
			{
				Text = "Scan the tender before you go in."
				Need { Parts = ["cosmoteer.sensor_array"] }
				Outcomes
				[
					{ Weight = 55; Text = "Six heat signatures and a real reactor leak. You pull them out with minutes to spare. The captain pays from the ore money."; Money = 0.5; Fame = 0.3 }
					{ Weight = 25; Text = "Your scan shows an empty hull and ships running dark behind an asteroid. You leave them waiting." }
					{ Weight = 20; Text = "Your scan shows a cold reactor and a dead drive. Not a trap, just bad luck."; Next = broken_down }
				]
			}
			{
				Text = "Ignore it. You have your own problems."
				Outcomes [ { Text = "You leave the beacon looping behind you." } ]
			}
		]
	}

	// From the Career 2.0 dev blog: a distress signal can be a broken-down ship that needs supplies or a tow (spec 88).
	{
		ID = broken_down
		Trigger = Arrival
		Weight = 8
		// Spec 767: the freighter carries the page. It hails you; its comms show the choices.
		Carrier = BrokenFreighter
		Title = "Dead in Space"
		Text = "A freighter drifts with its drive dark. Its engineer hails you, hands black with soot. \"Main coupling is fried. We need parts to patch it, or a tow to the nearest station. We can pay either way.\""
		Options
		[
			{ Text = "Steel plating"; Pay = Resource; Resource = steel; Unit = 25; UnitPerTier = 5; MinUnits = 0.5; MaxUnits = 2; StepUnits = 0.5; Points = 0.5 }
			{ Text = "Coils"; Pay = Resource; Resource = coil; Unit = 5; UnitPerTier = 1; MinUnits = 0.5; MaxUnits = 2; StepUnits = 0.5; Points = 0.5 }
		]
		OfferLine = "Parts for the repair: {0}% of what they need."
		Choices
		[
			{
				// Spec 811: half the points from steel, half from coil, or any mix. One share of each is the old cost.
				Text = "Hand over the selected parts."
				NeedPoints = 1
				Outcomes [ { Text = "With your parts, their drive coughs back to life. The captain pays and promises to forget your hull number."; Money = 0.5; Fame = 0.3; Reputation = 0.5 } ]
			}
			{
				Text = "Tow them to the nearest station."
				Need { Parts = ["cosmoteer.tractor_beam_emitter"] }
				Outcomes [ { Text = "You lock a tractor beam onto their hull. Pull them to the station and keep them in one piece; the crew pays on arrival."; Spawn = TowMission } ]
			}
			{
				Text = "Strip their cargo while they cannot run."
				Outcomes [ { Text = "Their hold is full of spare plating. Their distress call now has your ship's name in it."; Resources = [{ ID = steel; Amount = 30; PerTier = 6 }]; Heat = 10; Reputation = -1 } ]
			}
			{
				Text = "Leave them for someone else."
				Outcomes [ { Text = "Their beacon blinks behind you, patient and hopeful." } ]
			}
		]
	}

	{
		ID = stranded_freighter
		Trigger = Arrival
		Title = "Running on Empty"
		Text = "A freighter drifts dead in the lane, its captain hailing on every channel. \"We're dry. Give us enough hyperium to reach the next station and we'll pay what we can.\""
		Options
		[
			{ Text = "Hyperium"; Pay = Resource; Resource = hyperium; Unit = 20; UnitPerTier = 5; MinUnits = 0.25; MaxUnits = 2; StepUnits = 0.25 }
		]
		OfferLine = "Fuel to reach the station: {0}% of what they need."
		Choices
		[
			{
				Text = "Give them the fuel."
				NeedPoints = 1
				Outcomes
				[
					{ Text = "The captain thanks you, then lowers her voice. \"Corporate cutters asked about a ship like yours. I'll tell them you went the other way.\""; Fame = 0.4; Heat = -10 }
				]
			}
			{
				// The pay scales with the fuel sold: one share pays the old price.
				Text = "Sell it to them at three times the price."
				NeedPoints = 0.25
				ScaleByPoints = true
				Outcomes
				[
					{ Weight = 70; Text = "They pay. They do not thank you."; Money = 0.8 }
					{ Weight = 30; Text = "They pay, and then file a report about you on an open channel."; Money = 0.8; Heat = 8 }
				]
			}
			{
				Text = "Take their cargo instead."
				Outcomes
				[
					{ Weight = 60; Text = "Their hold is full of machine parts. Their distress call now has your ship's name in it."; Resources = [{ ID = steel; Amount = 30; PerTier = 6 }, { ID = coil; Amount = 10; PerTier = 2 }]; Heat = 15 }
					{ Weight = 40; Text = "Ships answer their call before you finish. They are not police."; Spawn = Raiders; Heat = 10 }
				]
			}
			{
				Text = "Leave them."
				Outcomes [ { Text = "Their hails follow you for a while, then stop." } ]
			}
		]
	}

	{
		ID = corporate_checkpoint
		Trigger = Arrival
		Weight = 8
		WeightPerHeat = 0.15
		Need { MinSector = 2; MinHeat = 10 }
		Title = "Corporate Checkpoint"
		Text = "A corporate customs cutter sits across the jump lane, its scanner already sweeping. \"Unidentified vessel, hold position for a routine cargo inspection.\"\n\nNothing about this is routine."
		Options
		[
			{ Text = "A private fee for the inspector"; Pay = Money; Unit = 0.6 }
			{ Text = "One crate as a \"seized sample\""; Pay = Tech; Need { Tech = 1 }; Sure = true }
			{
				Text = "Transmit the forged transponder codes"
				Need { Flags = [fake_codes] }
				HideIfUnmet = true
				Sure = true
				Effect { Text = "The scanner blinks green. \"Apologies for the delay, Inspector.\" The codes burn out after one use."; Heat = -10; ClearFlags = [fake_codes] }
			}
		]
		Choices
		[
			{
				// Spec 811: the bribe alone rolls like the old fee. A crate or the forged codes make it sure; the codes add heat -10 (old -20).
				Text = "Settle it quietly."
				NeedPoints = 1
				Outcomes
				[
					{ Weight = 80; Text = "The inspector waves you through. Your file goes in a drawer, for now."; Heat = -10 }
					{ Weight = 20; Text = "The inspector takes your offer and calls it in anyway."; Heat = 10 }
				]
			}
			{
				Text = "Submit to the scan and hope."
				Outcomes
				[
					{ Weight = 60; WeightPerTech = -8; Text = "The scanner sweeps the vault twice and finds only old shielding. You fly on." }
					{ Weight = 20; WeightPerTech = 8; Text = "The scanner stops on your vault and stays there."; Next = checkpoint_caught }
				]
			}
			{
				Text = "Run the checkpoint."
				Outcomes
				[
					{ Weight = 60; Text = "You punch through before the cutter can lock on. They will report it."; Heat = 15 }
					{ Weight = 40; Text = "The cutter was not alone."; Heat = 10; Spawn = CorporatePatrol }
				]
			}
		]
	}

	{
		ID = checkpoint_caught
		Title = "Corporate Checkpoint"
		Text = "\"Cargo mismatch. Stand by for boarding.\" Two more cutters power up behind the first."
		Choices
		[
			{
				Text = "Hand over one crate as evidence and take the fine."
				Need { Tech = 1 }
				Cost { Tech = 1 }
				Outcomes [ { Text = "They seize a crate and let you go with a warning. You both know the warning is a lie."; Heat = 5 } ]
			}
			{
				Text = "Break away and fight."
				Outcomes [ { Text = "You do not stand by. The cutters open fire."; Heat = 20; Spawn = CorporatePatrol } ]
			}
		]
	}

	{
		ID = defector
		Trigger = Arrival
		Need { MinSector = 3 }
		Title = "The Defector"
		Text = "An escape pod with a corporate logo hails you on a private band. \"My name is Dr. Ines Varga. I helped design what you stole. Get me out of here and I can make those tracking tags go quiet.\""
		Choices
		[
			{
				Text = "Bring her aboard."
				Outcomes
				[
					{ Weight = 75; Text = "Varga goes straight to your vault with a toolkit. An hour later the tags whisper instead of shout."; Crew = 1; Heat = -20; SetFlags = [defector] }
					{ Weight = 25; WeightPerHeat = 0.2; Text = "Varga smiles as the hatch seals. \"Sorry. They have my family.\" Her pod beacon was never off."; Heat = 25; Spawn = CorporatePatrol }
				]
			}
			{
				Text = "Turn her in for the reward."
				Outcomes
				[
					{ Text = "The corporation pays bounties, even to thieves. It also notes the hull that collected one."; Money = 1; Heat = 15 }
				]
			}
			{
				Text = "Leave the pod drifting."
				Outcomes [ { Text = "Her voice cuts off as you leave comms range." } ]
			}
		]
	}

	{
		ID = defector_contact
		Trigger = Arrival
		Weight = 30
		Need { MinSector = 5; Flags = [defector]; Tech = 2 }
		Title = "Varga's Old Office"
		Text = "Dr. Varga finds you on the bridge. \"My old research office is in this system. My assistant still has access. He could book a crate back into the company as recovered property. The payment would be very good.\""
		Choices
		[
			{
				Text = "Sell one crate through her assistant."
				Need { Tech = 1 }
				Cost { Tech = 1 }
				Outcomes
				[
					{ Weight = 80; Text = "The crate disappears into the corporate supply chain, booked as recovered. The payment is generous, and nobody is looking for that crate anymore."; MoneyTech = 1.6; Heat = -10 }
					{ Weight = 20; WeightPerHeat = 0.2; Text = "The assistant was already working for security. The crate is gone, and so is your head start."; Heat = 25; Spawn = CorporatePatrol }
				]
			}
			{
				Text = "Ask her to clean the tags one more time instead."
				Outcomes
				[
					{ Text = "She works through the night. \"That's all I can do,\" she says. \"After this they'll recognize my work.\""; Heat = -20; ClearFlags = [defector] }
				]
			}
			{
				Text = "Too risky."
				Outcomes [ { Text = "Varga nods. \"Probably wise.\"" } ]
			}
		]
	}

	{
		ID = rival_crew
		Trigger = Arrival
		Need { MinSector = 2; Tech = 2 }
		Title = "The Magpies"
		Text = "A battered gunship slides out of the sun's glare. \"Captain Rook of the Magpies. Heard you hit the lab. Nice haul.\" A pause. \"One crate and we never met. Otherwise we take the vault.\""
		Options
		[
			{ Text = "One crate"; Pay = Tech; Need { Tech = 1 }; Effect { SetFlags = [magpies_paid] } }
			{ Text = "Credits"; Pay = Money; Unit = 1.5; MinUnits = 0.1; MaxUnits = 1; StepUnits = 0.1 }
		]
		OfferLine = "Your offer: {0}% of Rook's price."
		Choices
		[
			{
				// Spec 811: one crate, or 1.5 money units in credits, as before. A crate still marks you as a payer.
				Text = "Pay Rook off."
				NeedPoints = 1
				Outcomes [ { Text = "Rook's crew takes the payment and salutes. \"Pleasure doing business.\"" } ]
			}
			{
				Text = "Fake a vault breach on your own transponder."
				Need { Parts = ["cosmoteer.sensor_array"] }
				Outcomes
				[
					{ Weight = 60; Text = "Your sensors broadcast a breached, empty vault. Rook laughs. \"Somebody beat us to it.\" The Magpies peel away." }
					{ Weight = 40; Text = "Rook is quiet for a second too long."; Next = rival_crew_bluff }
				]
			}
			{
				Text = "Tell Rook to come and take it."
				Outcomes [ { Text = "Rook sighs. \"Your funeral.\" The Magpies come in hot. Every station in the system has a bounty on them."; Spawn = Magpies } ]
			}
		]
	}

	{
		ID = rival_crew_bluff
		Title = "The Magpies"
		Text = "\"Cute trick,\" Rook says. \"My sensors are better than yours.\" Their guns come up."
		Choices
		[
			{
				Text = "Hand over one crate."
				Need { Tech = 1 }
				Cost { Tech = 1 }
				Outcomes [ { Text = "Rook takes the crate. \"Next time, don't insult me.\""; SetFlags = [magpies_paid] } ]
			}
			{
				Text = "Fight."
				Outcomes [ { Text = "So be it. Every station in the system has a bounty on the Magpies."; Spawn = Magpies } ]
			}
		]
	}

	{
		ID = siege
		Trigger = Arrival
		Need { MinSector = 2 }
		Title = "Freighter Under Fire"
		Text = "Weapons fire flickers at the edge of your sensors. A freighter is screaming for help: raiders, and its shields are failing. Nobody else is answering."
		Choices
		[
			{
				Text = "Go help them."
				Outcomes [ { Text = "You turn toward the fight. The freighter's captain starts a countdown on the open channel. Its shields will not last long."; Spawn = Siege } ]
			}
			{
				Text = "Stay out of it. A fight means attention."
				Outcomes [ { Text = "The freighter's calls stop a few minutes later." } ]
			}
		]
	}

	{
		ID = odd_merchant
		Trigger = Arrival
		Title = "The Odd Merchant"
		Text = "A ship made of three hulls welded together pulls alongside. Its owner grins through the comm. \"Mystery crate! Could be anything. Could be wonderful. No refunds.\""
		Choices
		[
			{
				Text = "Buy the crate."
				Cost { Money = 0.5 }
				Outcomes
				[
					{ Weight = 35; Text = "Processors, still in the factory wrap."; Resources = [{ ID = processor; Amount = 15; PerTier = 3 }] }
					{ Weight = 20; Text = "Diamonds. Real ones."; Resources = [{ ID = diamond; Amount = 10; PerTier = 2 }] }
					{ Weight = 20; Text = "A stowaway climbs out, stretches, and asks where her bunk is."; Crew = 1 }
					{ Weight = 15; Text = "Scrap. You should have expected that." }
					{ Weight = 10; Text = "The crate is empty, except for a blinking corporate tracker. Clever merchant."; Heat = 15 }
				]
			}
			{
				Text = "Offer him one tech crate for his whole hold."
				Need { Tech = 1 }
				Cost { Tech = 1 }
				Outcomes [ { Text = "He nearly faints. His whole hold is yours, plus every credit on board."; Money = 0.6; Resources = [{ ID = processor; Amount = 20; PerTier = 4 }, { ID = steel; Amount = 40; PerTier = 8 }] } ]
			}
			{
				Text = "No thanks."
				Outcomes [ { Text = "\"Your loss!\" The merchant is already hailing someone else." } ]
			}
		]
	}

	{
		ID = wanted_broadcast
		Trigger = Arrival
		Weight = 6
		WeightPerHeat = 0.1
		Need { MinSector = 2; MinHeat = 60 }
		Title = "Wanted Broadcast"
		Text = "Every comm buoy in the system is playing your hull number, your crew's faces and a reward figure with far too many zeros. Somewhere, local bounty hunters are already doing the math."
		Choices
		[
			{
				Text = "Pay the broadcaster to pull the bounty notice."
				Cost { Money = 1 }
				Outcomes [ { Text = "The station manager takes the credits and has a sudden technical fault. The buoys go back to playing shipping news."; Heat = -10 } ]
			}
			{
				Text = "Jam the nearest buoy and broadcast static."
				Need { Parts = ["cosmoteer.sensor_array"] }
				Outcomes
				[
					{ Weight = 70; Text = "The buoy chokes on your static. Nobody can see the notice, and nobody can trace the jam."; Heat = -5 }
					{ Weight = 30; Text = "Someone triangulates the jam. Hunters turn toward its source: you."; Spawn = BountyHunters }
				]
			}
			{
				Text = "Let them come. Bounty hunters have bounties too."
				Outcomes [ { Text = "Local hunters take the job. Their own warrants are posted on every station in the system."; Spawn = BountyHunters } ]
			}
			{
				Text = "Ignore it and keep moving."
				Outcomes
				[
					{ Weight = 50; Text = "The hunters in this system are busy elsewhere. For now." }
					{ Weight = 50; WeightPerHeat = 0.3; Text = "Ships drop out of the dark with their weapons warm. \"Nothing personal. The reward is very personal.\""; Spawn = BountyHunters }
				]
			}
		]
	}

	{
		ID = magpies_return
		Trigger = Arrival
		Weight = 30
		Need { Tech = 3; FlagAges = [{ Flag = magpies_paid; MinSectors = 2 }] }
		Title = "The Magpies Return"
		Text = "A familiar battered gunship, now with friends. \"Captain Rook again. You paid so nicely last time.\" A pause. \"Two crates now. Inflation.\"\n\nPaying once made you a mark."
		Options
		[
			{ Text = "Crates"; Pay = Tech; MinUnits = 1; MaxUnits = 2; Points = 0.5; Once { SetFlags = [magpies_paid] } }
			{ Text = "Credits"; Pay = Money; Unit = 2; MinUnits = 0.1; MaxUnits = 1; StepUnits = 0.1 }
		]
		OfferLine = "Your offer: {0}% of Rook's price."
		Choices
		[
			{
				// Spec 811: two crates or 2 money units, as before, or one crate and half the credits.
				Text = "Pay Rook."
				NeedPoints = 1
				Need { Tech = 1 }
				Outcomes [ { Text = "Rook's crew carries the payment off, laughing. \"See you around.\" You will, unless you end it." } ]
			}
			{
				Text = "Hand over a crate that Varga rigged to blow."
				Need { Flags = [defector]; Tech = 1 }
				HideIfUnmet = true
				Cost { Tech = 1 }
				Outcomes [ { Text = "Rook docks the crate in his own hold. A minute later his ship lights up like a flare. The other Magpies scatter and do not come back."; Fame = 0.5; Heat = 5; ClearFlags = [magpies_paid] } ]
			}
			{
				Text = "Not this time. Come and take them."
				Outcomes [ { Text = "\"Wrong answer.\" The Magpies come in hot, more of them and better armed. Their bounty has grown too."; Spawn = MagpiesReturn; ClearFlags = [magpies_paid] } ]
			}
		]
	}

	{
		ID = refugee_convoy
		Trigger = Arrival
		Need { MinSector = 3 }
		Title = "Refugee Convoy"
		Text = "Three overloaded transports limp along the lane: miners and their families, running from a corporate company town. Their convoy leader hails you. \"The corporation searches every convoy now. Please.\""
		Options
		[
			{
				Text = "Take refugees aboard"
				Unit = 1; MinUnits = 1; MaxUnits = 4; ValueText = "{0} people"; Points = 0.5
				Effect { Text = "Some of the miners know their way around a reactor and work for their passage. The corporation will search your hull too."; Crew = 1; Fame = 0.15; Reputation = 0.5; Heat = 5 }
			}
			{ Text = "Fuel and food for the trip"; Pay = Resource; Resource = hyperium; Unit = 15; UnitPerTier = 3; MinUnits = 0.5; MaxUnits = 2; StepUnits = 0.5; Effect { Fame = 0.3; Reputation = 1 } }
		]
		Choices
		[
			{
				// Spec 811: each refugee and each share of fuel has its own effects; two refugees or one share is the old choice.
				Text = "Help them."
				NeedPoints = 0.5
				Outcomes [ { Text = "The convoy leader salutes as they turn for the jump point. The locals will hear about this." } ]
			}
			{
				Text = "Sell their position to the corporation."
				Outcomes [ { Text = "The corporation pays, and for a few hours its cutters chase someone else. Nobody in this system will forget who sold the convoy."; Money = 1; Heat = -15; Fame = -0.5; Reputation = -2 } ]
			}
			{
				Text = "Wish them luck and fly on."
				Outcomes [ { Text = "You leave them to the lane." } ]
			}
		]
	}

	{
		ID = toll_gate
		Trigger = Arrival
		Need { MinSector = 2 }
		Title = "Pirate Toll Gate"
		Text = "Mines across the lane and pirate gunships at the gap. \"Toll gate. We know who you are, and we know the corporation pays for sightings. The hotter you are, the more you pay.\""
		Options
		[
			{ Text = "Credits"; Pay = Money; Unit = 0.3; UnitPerHeat = 0.01; MinUnits = 0.25; MaxUnits = 2; StepUnits = 0.25 }
			{ Text = "Steel"; Pay = Resource; Resource = steel; Unit = 30; UnitPerTier = 6; MinUnits = 0.5; MaxUnits = 2; StepUnits = 0.5 }
			{ Text = "Crew who join them"; Pay = Crew; MinUnits = 1; MaxUnits = 4; Points = 0.5 }
		]
		OfferLine = "Your payment: {0}% of the toll."
		Choices
		[
			{
				// Spec 811: one toll is the old money cost (0.3 + 0.01 per heat money units); steel and crew count too.
				Text = "Pay the toll."
				NeedPoints = 1
				Outcomes [ { Text = "They wave you through. \"You pay better than the corporation. For now.\"" } ]
			}
			{
				Text = "Pay double, and they report you heading the wrong way."
				NeedPoints = 2
				Outcomes [ { Text = "The pirates sell the corporation a sighting three systems off. Everyone gets paid, except the corporation."; Heat = -20 } ]
			}
			{
				Text = "Run the gate."
				Outcomes [ { Text = "You punch through the minefield. The gunships open fire, and their sighting goes out anyway."; Heat = 15; Spawn = TollGuards } ]
			}
		]
	}

	{
		ID = buyers_agent
		Trigger = Arrival
		Weight = 40
		Need { MinSectorsLeft = 1; MaxSectorsLeft = 2; Tech = 1 }
		Title = "The Buyer's Agent"
		Text = "A sleek courier matches your course. \"I represent the Buyer. My client offers an advance: credits now, against a lower price at delivery.\" The terms are already on your screen."
		Choices
		[
			{
				Text = "Take a small advance: the Buyer pays 80% at delivery."
				Outcomes [ { Text = "The credits arrive before the courier finishes its turn. The contract terms update."; MoneyTech = 1.5; BuyerPrice = 0.8 } ]
			}
			{
				Text = "Take a large advance: the Buyer pays 60% at delivery."
				Outcomes [ { Text = "\"A pleasure.\" The courier is gone, and so is a good part of your final payday."; MoneyTech = 3; BuyerPrice = 0.6 } ]
			}
			{
				Text = "Decline. You will be paid in full or not at all."
				Outcomes [ { Text = "\"As you wish. My client will be waiting.\"" } ]
			}
		]
	}

	// Unavoidable (spec 87): every choice costs something. At most Events.MaxUnavoidablePerRun of these per run.
	{
		ID = vault_coolant_leak
		Trigger = Arrival
		Category = Unavoidable
		// The category cap (Events.MaxUnavoidablePerRun) limits it, not a per-event limit.
		MaxPerRun = 0
		Need { Tech = 2 }
		Title = "Vault Coolant Leak"
		Text = "An alarm from the vault: a coolant line has ruptured, and the temperature is climbing. Prototype tech does not like heat. Something has to give."
		Options
		[
			{ Text = "Vent one crate"; Pay = Tech; Need { Tech = 1 }; Effect { Text = "The crate goes out the airlock in a cloud of frozen coolant." } }
			{
				Text = "Crew with extinguishers"
				Pay = CrewWork; MinUnits = 1; MaxUnits = 2; Points = 0.5
				Effect { Text = "Your crew seal the line by hand. Burns and scorched panels."; HullDamage = 0.075 }
				RiskChance = 0.2
				Risk { Text = "The vault flashes over before everyone is out."; Crew = -1 }
			}
			{ Text = "Emergency coolant from a station tug"; Pay = Money; Unit = 0.5; MinUnits = 0.25; MaxUnits = 1; StepUnits = 0.25 }
		]
		OfferLine = "Your fix covers {0}% of the leak."
		Choices
		[
			{
				// Spec 811: one crate, two crew (each 20 % to lose one, hull damage) or 0.5 money units, as before, or a mix.
				Text = "Stop the leak."
				NeedPoints = 1
				Outcomes [ { Text = "The coolant line holds. The vault cools down, slowly." } ]
			}
		]
	}

	// ---- Wanted (spec 471): offered when the players become wanted while the corporation hunts them. Both clear vanilla wanted.

	{
		ID = clean_record
		Trigger = Wanted
		Need { Wanted = true }
		Title = "A Clean Record"
		Text = "A private channel opens. \"The local police want you, and the corporation is right behind them. I can fix the first problem. Records are only numbers.\""
		Options
		[
			{ Text = "Credits"; Pay = Money; Unit = 0.4; UnitPerHeat = 0.01 }
			{ Text = "One crate"; Pay = Tech; Need { Tech = 1 }; Sure = true; Effect { Text = "A crate buys a lot of silence. The forger forgets the corporation's number."; Heat = -5 } }
		]
		Choices
		[
			{
				// Spec 811: credits roll like the old fee; a crate makes it sure and cuts heat by 5, as before.
				Text = "Buy the clean record."
				NeedPoints = 1
				Outcomes
				[
					{ Weight = 80; Text = "Your file goes quiet. The police stop looking."; ClearWanted = true }
					{ Weight = 20; WeightPerHeat = 0.2; Text = "The forger takes your payment, then sells your new record to the corporation."; Heat = 15 }
				]
			}
			{
				Text = "Handle it yourself."
				Outcomes [ { Text = "\"Your call. The offer stands while you last.\"" } ]
			}
		]
	}

	{
		ID = decoy_run
		Trigger = Wanted
		Need { Wanted = true }
		Title = "Decoy Run"
		Text = "A freighter captain hails on a tight beam. \"I can fly a copy of your transponder out the far side of the system. The police chase me, you slip away. Hunters might chase me too, if they are good.\""
		Choices
		[
			{
				Text = "Hire the decoy."
				Cost { Money = 0.5 }
				Outcomes
				[
					{ Weight = 70; Text = "The police take the bait and follow the freighter out of the system."; ClearWanted = true; Heat = -10 }
					{ Weight = 30; WeightPerHeat = 0.3; Text = "The police see through it. The captain keeps your money anyway." }
				]
			}
			{
				Text = "Fly the decoy yourself: a sensor ghost on the far side."
				Need { Parts = ["cosmoteer.sensor_array"] }
				Outcomes
				[
					{ Weight = 60; Text = "Your sensors paint a second ship far away. The police chase the ghost."; ClearWanted = true }
					{ Weight = 40; WeightPerHeat = 0.2; Text = "The ghost fools nobody. Worse, the corporation saw the broadcast."; Heat = 5 }
				]
			}
			{
				Text = "No thanks."
				Outcomes [ { Text = "\"Good luck out there.\"" } ]
			}
		]
	}

	// ---- Research (spec 760-763): offers built from the vanilla tech tree. Tokens: {offer_techs}, {offer_units}, {offer_worth},
	// {offer_value}, {offer_price}. A trade is always worth more research than buying it (Events.ResearchMinRate).

	{
		ID = research_trade
		Trigger = Station
		Offer = ResearchTrade
		Weight = 8
		Need { Tech = 2 }
		Title = "The Archive"
		Text = "The station's research office has seen your manifest. \"Our archive for your cargo: {offer_techs}. You would pay {offer_value} for that research anywhere else.\""
		Choices
		[
			{
				Text = "Trade {offer_units} (worth {offer_worth}) for research worth {offer_value}."
				Need { Tech = 1 }
				Cost { OfferUnits = true }
				Outcomes [ { Text = "The archive loads into your shipyard computers. New parts are ready to build."; UnlockOffer = true } ]
			}
			{
				Text = "Keep the crates."
				Outcomes [ { Text = "\"The archive will be here.\"" } ]
			}
		]
	}

	{
		ID = research_shakedown
		Trigger = Arrival
		Offer = ResearchTrade
		Weight = 6
		WeightPerHeat = 0.1
		Need { MinSector = 2; Tech = 2 }
		Title = "A Lab That Won't Take No"
		Text = "A rival lab's science ship hails. \"We want samples of what you stole. {offer_units} for our research: {offer_techs}. Refuse, and the corporation hears where you are.\""
		Choices
		[
			{
				Text = "Trade {offer_units} (worth {offer_worth}) for research worth {offer_value}."
				Need { Tech = 1 }
				Cost { OfferUnits = true }
				Outcomes [ { Text = "The samples go over. The research comes back, and the lab keeps its mouth shut."; UnlockOffer = true } ]
			}
			{
				Text = "Pay them to forget you."
				Cost { Money = 0.6 }
				Outcomes [ { Text = "\"Credits work too.\" The channel closes." } ]
			}
			{
				Text = "Refuse."
				Outcomes [ { Text = "They keep their word. Your position goes out on a corporate band."; Heat = 20 } ]
			}
		]
	}

	{
		ID = research_buyer
		Trigger = Arrival
		Offer = ResearchSale
		Weight = 6
		Need { MinSector = 2 }
		Title = "Data Broker"
		Text = "A sleek research ship hails. \"Your shipyard data on {offer_techs} is worth {offer_price} to my clients. A copy, nothing more. You keep the originals.\""
		Choices
		[
			{
				Text = "Sell copies for {offer_price}."
				Outcomes
				[
					{ Weight = 80; Text = "The transfer takes a minute. The payment takes less."; OfferPrice = true }
					{ Weight = 20; WeightPerHeat = 0.2; Text = "The broker pays, but the transfer carried a corporate tracker."; OfferPrice = true; Heat = 15 }
				]
			}
			{
				Text = "Keep your data."
				Outcomes [ { Text = "\"Another time, perhaps.\"" } ]
			}
		]
	}

	// Abandoned ships (spec 764) carry real loot now (mod/events/hulks.rules, spec 1124). No dialog.

	// ---- Friendly encounters (spec 1360 and later). Ships that carry their page and ask for something.

	// Spec 1361: a crew asks to join the fleet. A clear deal: pay their debts, and the ship is yours.
	{
		ID = join_request
		Trigger = Arrival
		Weight = 5
		Carrier = Recruit
		Title = "Join Request"
		Text = "A small crew hails you. \"Our captain sold us to the corporation and ran. We heard who you are. Clear our dock debts, and we fly under your colors.\""
		Choices
		[
			{
				Text = "Take them in."
				Cost { Money = 1 }
				Outcomes [ { Text = "They paint your colors on the hull."; Effect = join } ]
			}
			{
				Text = "Not now."
				Outcomes [ { Text = "\"Your loss.\" They turn away." } ]
			}
		]
	}

	// Spec 1362: a young crew asks to follow the players and learn. Free; what it sees decides how it ends (spec 1363).
	{
		ID = apprentice
		Trigger = Arrival
		Weight = 5
		Carrier = Recruit
		Title = "Apprentice"
		Text = "A young crew hails you, eager. \"Everyone talks about you. Let us fly with you for a while and learn how it's done. We'll fight at your side.\""
		Choices
		[
			{
				Text = "Let them follow."
				Outcomes [ { Text = "They fall in behind you."; Effect = apprentice } ]
			}
			{
				Text = "Not now."
				Outcomes [ { Text = "\"Maybe next time.\"" } ]
			}
		]
	}

	// Spec 1364: a wandering trader with a few trades at about twice the station value (vanilla BuyPrice). Clear deals: each row says
	// what goes and what comes. After a trade it jumps away (effect leave).
	{
		ID = wandering_trader
		Trigger = Arrival
		Weight = 5
		Carrier = Trader
		Title = "Wandering Trader"
		Text = "A battered hauler, its hold full of odd goods, hails you. \"I trade, I don't haggle. These rates are good for today only.\""
		Options
		[
			{ Text = "40 steel for 1 processor"; Pay = Resource; Resource = steel; Unit = 40; MinUnits = 1; MaxUnits = 3; Points = 1; Effect { Resources = [{ ID = processor; Amount = 1 }] } }
			{ Text = "10 coils for 10 tristeel"; Pay = Resource; Resource = coil; Unit = 10; MinUnits = 1; MaxUnits = 3; Points = 1; Effect { Resources = [{ ID = tristeel; Amount = 10 }] } }
			{ Text = "40 hyperium for 1 diamond"; Pay = Resource; Resource = hyperium; Unit = 40; MinUnits = 1; MaxUnits = 3; Points = 1; Effect { Resources = [{ ID = diamond; Amount = 1 }] } }
		]
		Choices
		[
			{
				Text = "Make the trades."
				NeedPoints = 1
				Outcomes [ { Text = "The crates change hulls. \"Pleasure.\" The trader spins up its drive."; Effect = leave } ]
			}
			{
				Text = "Not today."
				Outcomes [ { Text = "\"Your loss. I won't pass this way again.\"" } ]
			}
		]
	}

	// Spec 1365, 1366: the riddle ship. One riddle per run (flag riddle_met); the pool weighs 5 together, like the other encounters.
	// A right answer halves heat (effect halve_heat); a wrong one adds a little heat. The riddle and its answers are the page.
	{
		ID = riddle_hole
		Trigger = Arrival
		Weight = 1
		Need { MinHeat = 10; NotFlags = [riddle_met] }
		Carrier = RiddleShip
		Title = "Riddle Ship"
		Text = "A painted ship hails you. Its captain grins. \"Answer my riddle, and I talk to my contacts for you. What gets bigger the more you take away from it?\""
		Choices
		[
			{
				Text = "A hole."
				Outcomes [ { Text = "\"Ha! Right.\" They open a channel to their contacts and talk about you for a long time."; Effect = halve_heat; SetFlags = [riddle_met] } ]
			}
			{
				Text = "A debt."
				Outcomes [ { Text = "\"Wrong!\" They tell the story on an open channel, with your ship's name in it."; Heat = 3; SetFlags = [riddle_met] } ]
			}
			{
				Text = "A shadow."
				Outcomes [ { Text = "\"Wrong!\" They tell the story on an open channel, with your ship's name in it."; Heat = 3; SetFlags = [riddle_met] } ]
			}
			{
				Text = "No time for games."
				Outcomes [ { Text = "\"Your loss.\" The channel closes." } ]
			}
		]
	}

