// Hot Cargo event signals: unknown POIs that open a Signal event when a player ship reaches them (Events/EventRunner.cs).
// Added to the end of the sector system generator by mod/events/actions.rules. The autotest command ev_signal finds the group by its tag.
Type = Doodads
Tags = [hc_event_signal, hc_group_signal, poi_unknown]
DoodadType = cosmoteer.poi_unknown
SpawnChance = 80%
Count = [1, 2]
Distance = [3000, 19000]
MinDistanceFromTags = [[sun, 6000], [station, 4000], [bounty, 3000], [misc_discoverable, 2000], [hc_event_signal, 7000]]
MinDistanceFromNebulas = [[ion_storm, 1000]]
SuppressLocationAssertions = true
HideIfUnexplored = true
