// Hot Cargo event signals: unknown POIs that open a Signal event when a player ship reaches them (Events/EventRunner.cs).
// Added to the end of the sector system generator by mod/events/actions.rules. The autotest command ev_signal finds the group by its tag.
Type = Doodads
Tags = [hc_event_signal, hc_group_signal, poi_unknown]
DoodadType = cosmoteer.poi_unknown
SpawnChance = 80%
Count = [1, 2]
// Like the vanilla bounties at the system scale (spec 105, contracts/system_scale.rules).
Distance = ["(&<../contracts/system_scale.rules>/Scale) * 3000", "(&<../contracts/system_scale.rules>/Scale) * 19000"]
MinDistanceFromTags = [[sun, "max((&<../contracts/system_scale.rules>/Scale) * 6000, (&<../contracts/system_scale.rules>/SunClearance))"], [station, "(&<../contracts/system_scale.rules>/Scale) * 4000"], [bounty, "(&<../contracts/system_scale.rules>/Scale) * 3000"], [misc_discoverable, "(&<../contracts/system_scale.rules>/Scale) * 2000"], [hc_event_signal, "(&<../contracts/system_scale.rules>/Scale) * 7000"]]
MinDistanceFromNebulas = [[ion_storm, 1000]]
SuppressLocationAssertions = true
HideIfUnexplored = true
