// The run's relic ship (spec 765): a dead ship that holds 1 tech unit. Junk allegiance and the vanilla "abandoned" label, like the
// vanilla abandoned ships, so the players can also salvage it. 5,000 to 8,000 times the system scale from the fleet (spec 105), with an unknown POI.
Relic
{
	Spawners
	[
		{
			Type = Ships
			Tags = [hc_relic_ship]
			Count = 1
			Distance = ["(&<../contracts/system_scale.rules>/Scale) * 5000", "(&<../contracts/system_scale.rules>/Scale) * 8000"]
			MinDistanceFromTags = [[sun, "max((&<../contracts/system_scale.rules>/Scale) * 5000, (&<../contracts/system_scale.rules>/SunClearance))"], [station, "(&<../contracts/system_scale.rules>/Scale) * 3000"]]
			MinDistanceFromNebulas = [[ion_storm, 500]]
			SuppressLocationAssertions = true
			Allegiance = Junk
			InitToMax = false
			SpawnCrew = false
			RandomHealthRange = [25%, 60%]
			Labels = ["abandoned"]
			NameGenerator = { Type = NameList; Names = ["Dead Courier"]; }
			ShipCriteria
			{
				UseLocalFactionWeights = true
				UseTierField = true
				Tier = -2
				AllowTierRangeExpansion = true
				Tags = [civilian]
			}
			SubSpawners
			[
				{
					Type = Doodads
					DoodadType = cosmoteer.poi_unknown
					Tags = [poi_unknown]
					AutoRemoveWhenDiscovered = true
					HideIfUnexplored = true
				}
			]
		}
	]
}

// The freighter that carries Dead in Space (spec 767): it hails the players and its comms show the page.
