// Sealed Case: the Courier Job's cargo (spec 1100). Normal storage holds it, one case to a storage slot. Stations do not trade it.
// Sprites are the vanilla processor sprites with a tint.
ID = yarden_zamir.sealed_case
NameKey = "HotCargoEventMissions/SealedCase"
PluralNameKey = "HotCargoEventMissions/SealedCasePlural"
DescriptionKey = "HotCargoEventMissions/SealedCaseDesc"
// Never traded; 1, not 0, because some vanilla code divides by it.
BuyPrice = 1
MaxPerNugget = 1
MaxStackSize = 1
// Shares the processor key, so storage parts get no extra supply job.
FlexGridPriorityKey = "flex_grid_processor"
FlexGridDefaultPriority = 1
// A hit on its storage destroys the case half of the time; otherwise it drifts loose and the crew can pick it up.
DropRates
{
	StorageDestroyed = 50%
	StorageSalvaged = 100%
	CrewKilled = 100%
}
Rarity = Unique

TINT = [255, 150, 90]

Icon
{
	Texture
	{
		File = "./Data/resources/processor/icon.png"
		MipLevels = max
	}
	Size = [64, 64]
	VertexColor = &~/TINT
}

Overlay
{
	Texture
	{
		File = "./Data/resources/processor/overlay.png"
		SampleMode = Linear
		MipLevels = max
	}
	Size = [1, 1]
	VertexColor = &~/TINT
}

NuggetSprite
{
	File = "./Data/resources/processor/processor.png"
	NormalsFile = "./Data/resources/processor/processor_normals.png"
	Size = [1, 1]
	Offset = [.25+6/64, 0]
	UVRotation = 1
	VertexColor = &~/TINT
}

StackSprites
[
	{
		File = "./Data/resources/processor/processor_stack_1.png"
		Size = [1, 1]
		VertexColor = &~/TINT
	}
]

StackReceiveMediaEffects = &/COMMON_EFFECTS/ProcessorDeliver
StackPickupMediaEffects = &/COMMON_EFFECTS/ProcessorPickup
NuggetPickupMediaEffects = &/COMMON_EFFECTS/NuggetPickup

// Context actions (spec 1111): buttons on a storage part that holds a case. No dialog: the case opens in the hold.
// Usually corporate codes; the tracer weighs more as heat rises, like the old "Open it first" choice (60 / 40 + 0.3 x heat).
HotCargoActions
[
	{
		ID = open
		NameKey = "HotCargoItems/OpenCase"
		ToolTipKey = "HotCargoItems/OpenCaseTip"
		Becomes = yarden_zamir.opened_case
		Contents
		[
			{ Resource = yarden_zamir.access_codes; Weight = 60; MessageKey = "HotCargoItems/OpenedCodesFmt" }
			{ Resource = yarden_zamir.tracer_beacon; Weight = 40; WeightPerHeat = 0.3; MessageKey = "HotCargoItems/OpenedTracerFmt" }
		]
	}
]
