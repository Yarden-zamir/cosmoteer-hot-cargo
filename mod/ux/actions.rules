// UX: inline text icons (TextSprites). Mission icons are named hc_mission_<metatype ID>, so the code finds them by name.
// All art is vanilla: roof decal icons and GUI icons. They are white, and text tints them (colored='true').
// Heat change (mission lists).
{
	Action = Add
	AddTo = "<gui/text_sprites.rules>"
	Name = hc_heat
	ToAdd
	{
		Texture
		{
			File = "./Data/roof_decals/icons/icon_fire.png"
			MipLevels = max
			SampleMode = Linear
		}
		Size = [1, 1]
		ProportionalSize = true
	}
}
