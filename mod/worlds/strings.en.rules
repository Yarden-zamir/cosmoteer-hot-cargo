	HeatZoneShipFmt = "{0}"

	// Missions.
	HoldPass = "Hold the Pass"
	HoldPassDesc = "Raiders camp in a pass through the belt and tax every ship that passes. Clear them out, then hold the pass until the convoy is through. Keep a ship in the pass: if the pass stays empty, the raiders take it back."
