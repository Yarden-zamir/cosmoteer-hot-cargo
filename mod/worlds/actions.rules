	// Worlds (WORLDS.md): system archetypes. The run map picks them by weight (worlds/archetypes.rules, used by journey/galaxy.rules).
	{
		Action = AddMany
		AddTo = "<modes/career/sectors/sectors.rules>/Sectors"
		ManyToAdd
		[
			&<worlds/sectors.rules>/TradeHub
			&<worlds/sectors.rules>/MiningBelt
			&<worlds/sectors.rules>/SolarZone
			&<worlds/sectors.rules>/DeepSpace
		]
	}
	{
		Action = Add
		AddTo = "<modes/career/sectors/sector_basic/sector_basic.rules>/Sector/SystemGenerator/Spawners"
		ToAdd = &<worlds/sysgen_worlds.rules>
	}
	{
		Action = Add
		AddTo = "<nebulas/nebulas.rules>/NebulaTypes"
		ToAdd = &<worlds/current.rules>/Current
	}
	{
		Action = Overrides
		OverrideIn = "<modes/career/mission_metatypes.rules>"
		Overrides
		{
			HotCargoHoldPass
			{
				NameKey = "HotCargoWorlds/HoldPass"
				DescriptionKey = "HotCargoWorlds/HoldPassDesc"
				CategoryID = faction_wars
			}
			HotCargoSundive
			{
				NameKey = "HotCargoWorlds/Sundive"
				DescriptionKey = "HotCargoWorlds/SundiveDesc"
				CategoryID = exploration
			}
			HotCargoLairRaid
			{
				NameKey = "HotCargoWorlds/LairRaid"
				DescriptionKey = "HotCargoWorlds/LairRaidDesc"
				CategoryID = bounties
			}
		}
	}
