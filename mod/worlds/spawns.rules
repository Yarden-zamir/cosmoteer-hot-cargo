// Ships that Worlds objectives spawn during a mission. C# reads this file on first use (Worlds/WorldsSpawns.cs).
// It is not part of the game rules tree, so "&/" references do not work here. Use "&<./Data/...>" paths.
// The root location is given by the objective. A change here needs a game restart.

// A wave against the players who hold a pass (HotCargoHoldPass, spec 222). The root is a point outside the pass;
// the AI origin is that point, and the acquire range reaches into the pass.
PassRaiders
{
	Spawners
	[
		{
			Type = Ships
			Tags = [hc_pass_wave]
			Count = [1, 2]
			Distance = [0, 300]
			Allegiance = Unique
			SynchronizeAllegiance = true
			SuppressLocationAssertions = true
			FamePerTier = &<./Data/modes/career/tier_tables.rules>/StandardFamePerTier
			MaxFamePerTier = &<./Data/modes/career/tier_tables.rules>/StandardMaxFamePerTier
			ShipCriteria
			{
				UseLocalFactionWeights = true
				UseTierField = true
				Tier = -1
				AllowTierRangeExpansion = true
				Tags = [combat]
			}
			AI
			{
				Type = Normal
				ChanceToConsiderSurrenderingToPlayer = 0
				PatrolRadius = 600
				TargetAcquireRangeFromOrigin = 4000
				TargetUnacquireRangeFromOrigin = 6000
			}
		}
	]
}
