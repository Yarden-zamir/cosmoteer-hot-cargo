// Tech Vault (spec 14, 15, 440). One tile: the vanilla 2x2 storage bay art at 1x1 scale, with a tint and a single-type grid for Stolen Tech.
// The copy is on purpose: inheriting storage_2x2 would merge its FlexResourceGrid, which accepts any resource.
Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "HotCargoTech/TechVault"
	IconNameKey = "HotCargoTech/TechVaultIcon"
	ID = yarden_zamir.tech_vault
	EditorGroup = "Storage"
	DescriptionKey = "HotCargoTech/TechVaultDesc"
	JobsNameKey = "Parts/StorageGeneric"
	SelectionTypeID = "yarden_zamir.tech_vault"
	Resources
	[
		[steel, 24]
	]
	Size = [1, 1]
	IsRotateable = false
	// Three times a vanilla storage tile (the 2x2 bay has 4,000 for 4 tiles), below 1x1 armor (4,000). Spec 65: each half of this in damage destroys one unit.
	MaxHealth = 3000
	TypeCategories = [storage]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	IgnoreRotationForMirroredSelection = true
	TINT = [255, 200, 140]
	EditorIcon
	{
		Texture
		{
			File = "./Data/ships/terran/storage_2x2/icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
		VertexColor = &~/Part/TINT
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = CommandToggle
		}

		// 1 tile x MaxStackSize 2 = 2 units.
		Storage
		{
			Type = TypedResourceGrid
			ResourceType = yarden_zamir.stolen_tech
			GridRect = [0, 0, 1, 1]
			Layer = "doodads_low"
			SpriteInset = 8/64
			// The part cost counts InitToMaxResources x BuyPrice, and a new ship spawns filled to it. Tech comes only from the run start.
			InitToMaxResources = 0
			IsDrainable = false
			AllowExternalPickupAndDelivery = true
		}
		// Registers the tiles as sinks, so crew can put carried tech back into a vault.
		StorageConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = yarden_zamir.stolen_tech
			Storage = Storage
			DefaultPriority = &/PRIORITIES/Storage_Supply
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/storage_2x2/floor.png"
						Size = [1, 1]
						VertexColor = &~/Part/TINT
					}
					{
						File = "./Data/ships/terran/storage_2x2/floor_33.png"
						Size = [1, 1]
						VertexColor = &~/Part/TINT
					}
					{
						File = "./Data/ships/terran/storage_2x2/floor_66.png"
						Size = [1, 1]
						VertexColor = &~/Part/TINT
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/darkness/darkness1x1.png"
						Size = [1, 1]
						VertexColor = &~/Part/TINT
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/storage_2x2/walls.png"
						Size = [1, 1]
						VertexColor = &~/Part/TINT
					}
					{
						File = "./Data/ships/terran/storage_2x2/walls_33.png"
						Size = [1, 1]
						VertexColor = &~/Part/TINT
					}
					{
						File = "./Data/ships/terran/storage_2x2/walls_66.png"
						Size = [1, 1]
						VertexColor = &~/Part/TINT
					}
				]
			}
		}

		RoofDoorOpenToggle
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
		RoofDoorSprite
		{
			Type = OpenCloseSprite
			Location = [0.5, 0.5]
			OperationalToggle = RoofDoorOpenToggle
			Layer = "roofs"
			OpenDamageLevels
			[
				{
					AnimationFiles
					[
						"./Data/ships/terran/storage_2x2/roof1.png"
