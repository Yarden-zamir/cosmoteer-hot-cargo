// Stolen Tech (spec section 7). Sprites are the vanilla processor sprites with a tint.
// The C# code (src/HotCargo/Tech) replaces the trade price and keeps tech out of normal storage on human ships.
ID = yarden_zamir.stolen_tech
NameKey = "HotCargoTech/StolenTech"
PluralNameKey = "HotCargoTech/StolenTechPlural"
DescriptionKey = "HotCargoTech/StolenTechDesc"
// Static fallback only. TechPatches replaces buy and sell prices with the tech value (spec 19).
BuyPrice = 10000
// One crate holds one unit (spec 442).
MaxPerNugget = 1
// A Tech Vault has 1 tile, so it holds 2 units.
MaxStackSize = 2
// Normal storage on human ships never holds tech. Sharing the processor key keeps a useless
// "Supply Stolen Tech" job out of every storage part's job list.
FlexGridPriorityKey = "flex_grid_processor"
FlexGridDefaultPriority = 1
// A vault loses tech only when it is destroyed: it drops its tech as crates (spec 65, 445; VaultDropPatch burns it with a small chance). Salvage drops it too.
// Killed crew lose the tech they carry (spec 9): CrewKilled would fall back to StorageDestroyed without its own value.
DropRates
{
	StorageDestroyed = 100%
	StorageSalvaged = 100%
	CrewKilled = 0%
}
Rarity = Unique

TINT = [140, 255, 200]

Icon
{
	Texture
	{
		File = "./Data/resources/processor/icon.png"
		MipLevels = max
	}
	Size = [64, 64]
	VertexColor = &~/TINT
}

Overlay
{
	Texture
	{
		File = "./Data/resources/processor/overlay.png"
		SampleMode = Linear
		MipLevels = max
	}
	Size = [1, 1]
	VertexColor = &~/TINT
}

NuggetSprite
{
	File = "./Data/resources/processor/processor.png"
	NormalsFile = "./Data/resources/processor/processor_normals.png"
	Size = [1, 1]
	Offset = [.25+6/64, 0]
	UVRotation = 1
	VertexColor = &~/TINT
}

// One sprite per unit (spec 442): 1 unit shows one item, 2 units show two. Vanilla picks sprite (units - 1).
StackSprites
[
	{
		File = "./Data/resources/processor/processor_stack_1.png"
		Size = [1, 1]
		VertexColor = &~/TINT
	}
	{
		File = "./Data/resources/processor/processor_stack_2.png"
		Size = [1, 1]
		VertexColor = &~/TINT
	}
]

StackReceiveMediaEffects = &/COMMON_EFFECTS/ProcessorDeliver
StackPickupMediaEffects = &/COMMON_EFFECTS/ProcessorPickup
NuggetPickupMediaEffects = &/COMMON_EFFECTS/NuggetPickup
