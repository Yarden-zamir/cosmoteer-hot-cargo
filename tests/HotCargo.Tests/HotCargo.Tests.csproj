<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every pure model file (*Model.cs: no game types). Run with dotnet run in this folder. -->
    <Compile Include="../../src/HotCargo/**/*Model.cs" Exclude="../../src/HotCargo/bin/**;../../src/HotCargo/obj/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
