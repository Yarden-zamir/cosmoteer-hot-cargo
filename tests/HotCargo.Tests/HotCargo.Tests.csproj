<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only pure model files, with no game types. Run with dotnet run in this folder. -->
    <Compile Include="../../src/HotCargo/Core/HeatModel.cs" />
    <Compile Include="../../src/HotCargo/Tech/TechModel.cs" />
    <Compile Include="../../src/HotCargo/Missions/MissionModel.cs" />
    <Compile Include="../../src/HotCargo/Tactics/TacticsModel.cs" />
    <Compile Include="../../src/HotCargo/Events/EventModel.cs" />
    <Compile Include="../../src/HotCargo/Contracts/ContractsModel.cs" />
    <Compile Include="../../src/HotCargo/Worlds/WorldsModel.cs" />
    <Compile Include="../../src/HotCargo/Chains/ChainModel.cs" />
    <Compile Include="../../src/HotCargo/Hunters/WaveModel.cs" />
    <Compile Include="../../src/HotCargo/Ai/AiModel.cs" />
    <Compile Include="../../src/HotCargo/Ai/PersonalityModel.cs" />
    <Compile Include="../../src/HotCargo/Missions/Mechanics/MechanicsModel.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
