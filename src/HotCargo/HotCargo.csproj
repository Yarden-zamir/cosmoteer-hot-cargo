<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>HotCargo</AssemblyName>
    <RootNamespace>HotCargo</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Game files are copied from the PC into .game by scripts/pull-game.sh. They are not committed. -->
    <CosmoteerBin Condition="'$(CosmoteerBin)' == ''">$(MSBuildThisFileDirectory)../../../.game/Bin</CosmoteerBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Cosmoteer"><HintPath>$(CosmoteerBin)/Cosmoteer.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HalflingCore"><HintPath>$(CosmoteerBin)/HalflingCore.dll</HintPath><Private>false</Private></Reference>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" />
    <Publicize Include="Cosmoteer" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="HalflingCore" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>
</Project>
